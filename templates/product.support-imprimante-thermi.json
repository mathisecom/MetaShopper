n\n  <section class=\"ms-final-cta\">\n\n    <div>\n\n      <span class=\"ms-kicker\">\n        METASHOPPER\n      </span>\n\n      <h2>\n        Organisez votre poste d'expédition\n        <span>dès aujourd'hui</span>\n      </h2>\n\n      <p>\n        Gardez votre rouleau d'étiquettes à portée de main et créez\n        un espace plus propre pour préparer vos commandes.\n      </p>\n\n      <button\n        type=\"button\"\n        class=\"ms-main-button ms-main-button--dark\"\n        onclick=\"window.scrollTo({top:0,behavior:'smooth'});\"\n      >\n        Commander mon support\n        <span>↑</span>\n      </button>\n\n    </div>\n\n\n    <div class=\"ms-final-trust\">\n\n      <span>\n        🚚\n        <strong>Livraison 24/48 h</strong>\n      </span>\n\n      <span>\n        ✓\n        <strong>Garantie 2 ans</strong>\n      </span>\n\n      <span>\n        ↩\n        <strong>Retours 30 jours</strong>\n      </span>\n\n      <span>\n        ◉\n        <strong>SAV 24/7</strong>\n      </span>\n\n    </div>\n\n  </section>\n\n</div>\n\n\n<style>\n\n/* ========================================================\n   DESIGN SYSTEM METASHOPPER\n======================================================== */\n\n.ms-holder-page {\n\n  --ms-orange: #FF4500;\n  --ms-orange-dark: #E83F00;\n\n  --ms-black: #181818;\n  --ms-text: #242424;\n  --ms-muted: #686868;\n\n  --ms-light: #F7F7F9;\n  --ms-border: #E5E5E7;\n  --ms-white: #FFFFFF;\n\n  width: 100%;\n  max-width: 1320px;\n\n  margin: 0 auto;\n\n  color: var(--ms-text);\n\n  font-family: inherit;\n\n  line-height: 1.5;\n}\n\n.ms-holder-page,\n.ms-holder-page * {\n  box-sizing: border-box;\n}\n\n.ms-holder-page img {\n  display: block;\n\n  width: 100%;\n  max-width: 100%;\n}\n\n\n/* ========================================================\n   GENERAL\n======================================================== */\n\n.ms-section {\n  margin: 76px 0;\n}\n\n.ms-kicker {\n\n  display: block;\n\n  margin-bottom: 12px;\n\n  color: var(--ms-orange);\n\n  font-size: 11px;\n  font-weight: 750;\n\n  line-height: 1.2;\n\n  letter-spacing: .12em;\n\n  text-transform: uppercase;\n}\n\n.ms-heading {\n\n  max-width: 780px;\n\n  margin: 0 auto 38px;\n\n  text-align: center;\n}\n\n.ms-heading h2,\n.ms-holder-hero h2,\n.ms-split h2,\n.ms-marketplace-section h2,\n.ms-detail-section h2,\n.ms-specs h2,\n.ms-final-cta h2 {\n\n  margin: 0;\n\n  color: var(--ms-black);\n\n  font-size: clamp(28px, 3.2vw, 45px);\n\n  line-height: 1.08;\n\n  letter-spacing: -.035em;\n\n  font-weight: 760;\n}\n\n.ms-holder-page h2 span {\n\n  color: var(--ms-orange);\n}\n\n.ms-heading p {\n\n  max-width: 650px;\n\n  margin: 15px auto 0;\n\n  color: var(--ms-muted);\n\n  font-size: 15px;\n}\n\n\n/* ========================================================\n   BUTTON\n======================================================== */\n\n.ms-main-button {\n\n  min-height: 50px;\n\n  width: fit-content;\n\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 17px;\n\n  padding: 0 24px;\n\n  border: 0;\n  border-radius: 2px;\n\n  background: var(--ms-orange);\n\n  color: #FFFFFF;\n\n  font-family: inherit;\n\n  font-size: 13px;\n  font-weight: 750;\n\n  cursor: pointer;\n\n  transition:\n    background .2s ease,\n    transform .2s ease;\n}\n\n.ms-main-button:hover {\n\n  background: var(--ms-orange-dark);\n\n  transform: translateY(-1px);\n}\n\n.ms-main-button span {\n\n  font-size: 18px;\n}\n\n.ms-main-button--dark {\n\n  background: var(--ms-black);\n}\n\n.ms-main-button--dark:hover {\n\n  background: #000000;\n}\n\n\n/* ========================================================\n   HERO\n======================================================== */\n\n.ms-holder-hero {\n\n  display: grid;\n\n  grid-template-columns: 1fr 1fr;\n\n  min-height: 600px;\n\n  overflow: hidden;\n\n  background: var(--ms-light);\n}\n\n.ms-holder-hero__content {\n\n  display: flex;\n\n  flex-direction: column;\n\n  justify-content: center;\n\n  padding: 62px;\n}\n\n.ms-holder-hero h2 {\n\n  max-width: 620px;\n\n  font-size: clamp(36px, 4vw, 56px);\n}\n\n.ms-lead {\n\n  max-width: 600px;\n\n  margin: 22px 0 0;\n\n  color: var(--ms-muted);\n\n  font-size: 16px;\n}\n\n.ms-hero-points {\n\n  display: grid;\n\n  gap: 13px;\n\n  margin: 28px 0;\n}\n\n.ms-hero-point {\n\n  display: flex;\n\n  align-items: flex-start;\n\n  gap: 11px;\n}\n\n.ms-check {\n\n  width: 23px;\n  height: 23px;\n\n  flex: 0 0 23px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  border-radius: 50%;\n\n  background: var(--ms-orange);\n\n  color: #FFFFFF;\n\n  font-size: 12px;\n  font-weight: 800;\n}\n\n.ms-hero-point strong,\n.ms-hero-point small {\n\n  display: block;\n}\n\n.ms-hero-point strong {\n\n  color: var(--ms-black);\n\n  font-size: 14px;\n}\n\n.ms-hero-point small {\n\n  margin-top: 2px;\n\n  color: var(--ms-muted);\n\n  font-size: 11px;\n}\n\n.ms-holder-hero__image {\n\n  min-height: 600px;\n\n  overflow: hidden;\n}\n\n.ms-holder-hero__image img {\n\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n}\n\n.ms-trust {\n\n  display: flex;\n\n  flex-wrap: wrap;\n\n  gap: 12px 17px;\n\n  margin-top: 22px;\n\n  color: var(--ms-muted);\n\n  font-size: 10px;\n}\n\n\n/* ========================================================\n   BENEFITS\n======================================================== */\n\n.ms-benefits {\n\n  display: grid;\n\n  grid-template-columns: repeat(4,minmax(0,1fr));\n\n  gap: 10px;\n}\n\n.ms-benefit {\n\n  padding: 27px 22px;\n\n  background: var(--ms-light);\n}\n\n.ms-icon {\n\n  width: 37px;\n  height: 37px;\n\n  margin-bottom: 17px;\n\n  color: var(--ms-orange);\n}\n\n.ms-icon svg {\n\n  width: 100%;\n  height: 100%;\n\n  stroke: currentColor;\n\n  stroke-width: 1.6;\n\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.ms-benefit h3 {\n\n  margin: 0 0 7px;\n\n  color: var(--ms-black);\n\n  font-size: 15px;\n}\n\n.ms-benefit p {\n\n  margin: 0;\n\n  color: var(--ms-muted);\n\n  font-size: 12px;\n}\n\n\n/* ========================================================\n   SPLIT\n======================================================== */\n\n.ms-split {\n\n  display: grid;\n\n  grid-template-columns: 1fr 1fr;\n\n  background: var(--ms-light);\n}\n\n.ms-split__image {\n\n  min-height: 560px;\n\n  overflow: hidden;\n}\n\n.ms-split__image img {\n\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n}\n\n.ms-split__content {\n\n  display: flex;\n\n  flex-direction: column;\n\n  justify-content: center;\n\n  padding: 58px;\n}\n\n.ms-split__content > p {\n\n  margin: 19px 0 0;\n\n  color: var(--ms-muted);\n\n  font-size: 15px;\n}\n\n.ms-split--reverse .ms-split__image {\n\n  order: 2;\n}\n\n.ms-split--reverse .ms-split__content {\n\n  order: 1;\n}\n\n\n/* ========================================================\n   FEATURE LINES\n======================================================== */\n\n.ms-feature-lines {\n\n  margin-top: 28px;\n}\n\n.ms-feature-lines > div {\n\n  display: flex;\n\n  gap: 15px;\n\n  padding: 13px 0;\n\n  border-top: 1px solid var(--ms-border);\n}\n\n.ms-feature-lines > div:last-child {\n\n  border-bottom: 1px solid var(--ms-border);\n}\n\n.ms-feature-lines > div > span {\n\n  min-width: 23px;\n\n  color: var(--ms-orange);\n\n  font-size: 11px;\n\n  font-weight: 750;\n}\n\n.ms-feature-lines p {\n\n  margin: 0;\n}\n\n.ms-feature-lines strong,\n.ms-feature-lines small {\n\n  display: block;\n}\n\n.ms-feature-lines strong {\n\n  color: var(--ms-black);\n\n  font-size: 13px;\n}\n\n.ms-feature-lines small {\n\n  color: var(--ms-muted);\n\n  font-size: 11px;\n}\n\n\n/* ========================================================\n   LIST\n======================================================== */\n\n.ms-list {\n\n  display: grid;\n\n  gap: 12px;\n\n  margin: 27px 0 0;\n\n  padding: 0;\n\n  list-style: none;\n}\n\n.ms-list li {\n\n  display: flex;\n\n  gap: 9px;\n\n  font-size: 13px;\n}\n\n.ms-list li span {\n\n  color: var(--ms-orange);\n\n  font-weight: 800;\n}\n\n\n/* ========================================================\n   MARKETPLACE SECTION\n======================================================== */\n\n.ms-marketplace-section {\n\n  display: grid;\n\n  grid-template-columns: .9fr 1.1fr;\n\n  background: var(--ms-light);\n}\n\n.ms-marketplace-section__content {\n\n  display: flex;\n\n  flex-direction: column;\n\n  justify-content: center;\n\n  padding: 58px;\n}\n\n.ms-marketplace-section__content > p {\n\n  margin: 18px 0 24px;\n\n  color: var(--ms-muted);\n\n  font-size: 14px;\n}\n\n.ms-marketplace-section__image {\n\n  min-height: 530px;\n\n  overflow: hidden;\n}\n\n.ms-marketplace-section__image img {\n\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n}\n\n.ms-pills {\n\n  display: flex;\n\n  flex-wrap: wrap;\n\n  gap: 7px;\n}\n\n.ms-pills span {\n\n  padding: 9px 14px;\n\n  background: white;\n\n  border: 1px solid var(--ms-border);\n\n  color: var(--ms-black);\n\n  font-size: 11px;\n\n  font-weight: 650;\n}\n\n.ms-notice {\n\n  display: flex;\n\n  gap: 11px;\n\n  margin-top: 24px;\n\n  padding: 14px;\n\n  border-left: 3px solid var(--ms-orange);\n\n  background: white;\n}\n\n.ms-notice > span {\n\n  width: 21px;\n  height: 21px;\n\n  flex: 0 0 21px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  border-radius: 50%;\n\n  background: var(--ms-orange);\n\n  color: white;\n\n  font-size: 10px;\n\n  font-weight: 750;\n}\n\n.ms-notice p {\n\n  margin: 0;\n\n  color: var(--ms-muted);\n\n  font-size: 10px;\n}\n\n\n/* ========================================================\n   DARK TRANSPORT\n======================================================== */\n\n.ms-dark-section {\n\n  padding: 52px 30px;\n\n  background: var(--ms-black);\n}\n\n.ms-dark-section .ms-heading h2 {\n\n  color: white;\n}\n\n.ms-dark-section .ms-heading p {\n\n  color: rgba(255,255,255,.7);\n}\n\n.ms-carriers {\n\n  display: flex;\n\n  flex-wrap: wrap;\n\n  justify-content: center;\n\n  gap: 8px;\n}\n\n.ms-carriers span {\n\n  padding: 10px 16px;\n\n  border: 1px solid rgba(255,255,255,.15);\n\n  background: rgba(255,255,255,.06);\n\n  color: white;\n\n  font-size: 11px;\n\n  font-weight: 650;\n}\n\n\n/* ========================================================\n   INSTALLATION\n======================================================== */\n\n.ms-install-steps {\n\n  display: grid;\n\n  grid-template-columns: repeat(4,1fr);\n\n  gap: 1px;\n\n  border: 1px solid var(--ms-border);\n\n  background: var(--ms-border);\n}\n\n.ms-install-steps article {\n\n  padding: 27px 22px;\n\n  background: white;\n}\n\n.ms-step-number {\n\n  display: block;\n\n  margin-bottom: 23px;\n\n  color: var(--ms-orange);\n\n  font-size: 23px;\n\n  font-weight: 760;\n}\n\n.ms-install-steps h3 {\n\n  margin: 0 0 7px;\n\n  color: var(--ms-black);\n\n  font-size: 14px;\n}\n\n.ms-install-steps p {\n\n  margin: 0;\n\n  color: var(--ms-muted);\n\n  font-size: 11px;\n}\n\n.ms-install-image {\n\n  margin-top: 12px;\n\n  max-height: 620px;\n\n  overflow: hidden;\n}\n\n.ms-install-image img {\n\n  width: 100%;\n\n  max-height: 620px;\n\n  object-fit: cover;\n}\n\n\n/* ========================================================\n   DETAIL HERO\n======================================================== */\n\n.ms-detail-section {\n\n  position: relative;\n\n  min-height: 600px;\n\n  overflow: hidden;\n\n  background: var(--ms-black);\n}\n\n.ms-detail-section__image,\n.ms-detail-section__image img {\n\n  position: absolute;\n\n  inset: 0;\n\n  width: 100%;\n  height: 100%;\n}\n\n.ms-detail-section__image img {\n\n  object-fit: cover;\n}\n\n.ms-detail-section__image::after {\n\n  content: \"\";\n\n  position: absolute;\n\n  inset: 0;\n\n  background:\n    linear-gradient(\n      90deg,\n      rgba(0,0,0,.78),\n      rgba(0,0,0,.38) 50%,\n      rgba(0,0,0,.04)\n    );\n}\n\n.ms-detail-section__content {\n\n  position: relative;\n\n  z-index: 2;\n\n  max-width: 600px;\n\n  min-height: 600px;\n\n  display: flex;\n\n  flex-direction: column;\n\n  justify-content: center;\n\n  padding: 65px;\n}\n\n.ms-detail-section h2 {\n\n  color: white;\n}\n\n.ms-detail-section p {\n\n  margin: 18px 0 0;\n\n  color: rgba(255,255,255,.8);\n\n  font-size: 14px;\n}\n\n\n/* ========================================================\n   TABLE\n======================================================== */\n\n.ms-table-wrapper {\n\n  overflow-x: auto;\n\n  border: 1px solid var(--ms-border);\n}\n\n.ms-table {\n\n  width: 100%;\n\n  min-width: 650px;\n\n  border-collapse: collapse;\n}\n\n.ms-table th,\n.ms-table td {\n\n  padding: 16px 19px;\n\n  border-bottom: 1px solid var(--ms-border);\n\n  text-align: center;\n\n  font-size: 12px;\n}\n\n.ms-table th:first-child,\n.ms-table td:first-child {\n\n  text-align: left;\n}\n\n.ms-table th {\n\n  background: var(--ms-light);\n\n  color: var(--ms-black);\n}\n\n.ms-table-highlight {\n\n  background: #FFF1EB !important;\n\n  color: var(--ms-black);\n\n  font-weight: 650;\n}\n\n\n/* ========================================================\n   SPECS\n======================================================== */\n\n.ms-specs {\n\n  padding: 52px;\n\n  background: var(--ms-light);\n}\n\n.ms-specs__heading {\n\n  margin-bottom: 28px;\n}\n\n.ms-specs__grid {\n\n  display: grid;\n\n  grid-template-columns: 1fr 1fr;\n\n  background: white;\n\n  border-top: 1px solid var(--ms-border);\n\n  border-left: 1px solid var(--ms-border);\n}\n\n.ms-specs__grid > div {\n\n  padding: 17px 19px;\n\n  border-right: 1px solid var(--ms-border);\n\n  border-bottom: 1px solid var(--ms-border);\n}\n\n.ms-specs__grid span,\n.ms-specs__grid strong {\n\n  display: block;\n}\n\n.ms-specs__grid span {\n\n  margin-bottom: 4px;\n\n  color: var(--ms-muted);\n\n  font-size: 9px;\n\n  letter-spacing: .08em;\n\n  text-transform: uppercase;\n}\n\n.ms-specs__grid strong {\n\n  color: var(--ms-black);\n\n  font-size: 13px;\n\n  font-weight: 650;\n}\n\n\n/* ========================================================\n   CROSS SELL\n======================================================== */\n\n.ms-crosssell {\n\n  display: grid;\n\n  grid-template-columns: repeat(3,1fr);\n\n  gap: 9px;\n}\n\n.ms-crosssell-card {\n\n  min-height: 100px;\n\n  display: flex;\n\n  align-items: center;\n\n  gap: 14px;\n\n  padding: 19px;\n\n  background: var(--ms-light);\n\n  color: inherit !important;\n\n  text-decoration: none !important;\n}\n\n.ms-crosssell-number {\n\n  width: 35px;\n  height: 35px;\n\n  flex: 0 0 35px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  background: var(--ms-orange);\n\n  color: white;\n\n  font-size: 10px;\n\n  font-weight: 760;\n}\n\n.ms-crosssell-card div {\n\n  flex: 1;\n}\n\n.ms-crosssell-card strong,\n.ms-crosssell-card small {\n\n  display: block;\n}\n\n.ms-crosssell-card strong {\n\n  color: var(--ms-black);\n\n  font-size: 13px;\n}\n\n.ms-crosssell-card small {\n\n  margin-top: 3px;\n\n  color: var(--ms-muted);\n\n  font-size: 10px;\n}\n\n.ms-arrow {\n\n  color: var(--ms-orange);\n\n  font-size: 18px;\n}\n\n\n/* ========================================================\n   FAQ\n======================================================== */\n\n.ms-faq {\n\n  max-width: 900px;\n\n  margin-left: auto;\n  margin-right: auto;\n}\n\n.ms-faq__items {\n\n  border-top: 1px solid var(--ms-border);\n}\n\n.ms-faq details {\n\n  border-bottom: 1px solid var(--ms-border);\n}\n\n.ms-faq summary {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 18px;\n\n  padding: 20px 2px;\n\n  color: var(--ms-black);\n\n  font-size: 14px;\n\n  font-weight: 650;\n\n  cursor: pointer;\n\n  list-style: none;\n}\n\n.ms-faq summary::-webkit-details-marker {\n\n  display: none;\n}\n\n.ms-faq summary span {\n\n  color: var(--ms-orange);\n\n  font-size: 22px;\n\n  font-weight: 300;\n\n  transition: transform .2s ease;\n}\n\n.ms-faq details[open] summary span {\n\n  transform: rotate(45deg);\n}\n\n.ms-faq details > div {\n\n  padding: 0 38px 20px 2px;\n\n  color: var(--ms-muted);\n\n  font-size: 13px;\n}\n\n\n/* ========================================================\n   FINAL CTA\n======================================================== */\n\n.ms-final-cta {\n\n  margin-top: 76px;\n\n  padding: 52px 60px;\n\n  background: #FFF1EB;\n}\n\n.ms-final-cta__content {\n\n  max-width: 800px;\n}\n\n.ms-final-cta p {\n\n  max-width: 650px;\n\n  margin: 15px 0 24px;\n\n  color: var(--ms-muted);\n\n  font-size: 14px;\n}\n\n.ms-final-trust {\n\n  display: grid;\n\n  grid-template-columns: repeat(4,1fr);\n\n  gap: 1px;\n\n  margin-top: 35px;\n\n  background: rgba(0,0,0,.08);\n}\n\n.ms-final-trust span {\n\n  padding: 15px;\n\n  background: white;\n\n  color: var(--ms-muted);\n\n  text-align: center;\n\n  font-size: 10px;\n}\n\n.ms-final-trust strong {\n\n  color: var(--ms-black);\n}\n\n\n/* ========================================================\n   TABLETTE\n======================================================== */\n\n@media screen and (max-width: 989px) {\n\n  .ms-section {\n\n    margin: 56px 0;\n  }\n\n  .ms-holder-hero,\n  .ms-split,\n  .ms-marketplace-section {\n\n    grid-template-columns: 1fr;\n  }\n\n  .ms-holder-hero__content,\n  .ms-split__content,\n  .ms-marketplace-section__content {\n\n    padding: 44px;\n  }\n\n  .ms-holder-hero__image,\n  .ms-split__image,\n  .ms-marketplace-section__image {\n\n    min-height: 480px;\n  }\n\n  .ms-split--reverse .ms-split__image,\n  .ms-split--reverse .ms-split__content {\n\n    order: initial;\n  }\n\n  .ms-benefits,\n  .ms-install-steps {\n\n    grid-template-columns: repeat(2,1fr);\n  }\n\n  .ms-crosssell {\n\n    grid-template-columns: 1fr;\n  }\n\n}\n\n\n/* ========================================================\n   MOBILE\n======================================================== */\n\n@media screen and (max-width: 749px) {\n\n  .ms-section {\n\n    margin: 40px 0;\n  }\n\n  .ms-heading {\n\n    margin-bottom: 24px;\n\n    padding: 0 4px;\n  }\n\n  .ms-heading h2,\n  .ms-holder-hero h2,\n  .ms-split h2,\n  .ms-marketplace-section h2,\n  .ms-detail-section h2,\n  .ms-specs h2,\n  .ms-final-cta h2 {\n\n    font-size: 27px;\n  }\n\n  .ms-kicker {\n\n    font-size: 9px;\n  }\n\n\n  .ms-holder-hero {\n\n    display: flex;\n\n    flex-direction: column;\n  }\n\n  .ms-holder-hero__content {\n\n    padding: 29px 19px 32px;\n  }\n\n  .ms-lead {\n\n    font-size: 13px;\n  }\n\n  .ms-holder-hero__image {\n\n    min-height: 350px;\n  }\n\n  .ms-main-button {\n\n    width: 100%;\n  }\n\n  .ms-trust {\n\n    justify-content: center;\n  }\n\n\n  .ms-benefits {\n\n    grid-template-columns: repeat(2,1fr);\n\n    gap: 6px;\n  }\n\n  .ms-benefit {\n\n    padding: 18px 13px;\n  }\n\n  .ms-icon {\n\n    width: 29px;\n    height: 29px;\n  }\n\n  .ms-benefit h3 {\n\n    font-size: 12px;\n  }\n\n  .ms-benefit p {\n\n    font-size: 10px;\n  }\n\n\n  .ms-split__image,\n  .ms-marketplace-section__image {\n\n    min-height: 340px;\n  }\n\n  .ms-split__content,\n  .ms-marketplace-section__content {\n\n    padding: 31px 19px;\n  }\n\n  .ms-split__content > p,\n  .ms-marketplace-section__content > p {\n\n    font-size: 13px;\n  }\n\n\n  .ms-install-steps {\n\n    grid-template-columns: repeat(2,1fr);\n  }\n\n  .ms-install-steps article {\n\n    padding: 20px 14px;\n  }\n\n  .ms-step-number {\n\n    margin-bottom: 16px;\n\n    font-size: 19px;\n  }\n\n\n  .ms-detail-section {\n\n    min-height: 500px;\n  }\n\n  .ms-detail-section__content {\n\n    min-height: 500px;\n\n    justify-content: flex-end;\n\n    padding: 34px 19px;\n  }\n\n  .ms-detail-section__image::after {\n\n    background:\n      linear-gradient(\n        0deg,\n        rgba(0,0,0,.84),\n        rgba(0,0,0,.25) 72%,\n        rgba(0,0,0,.03)\n      );\n  }\n\n\n  .ms-specs {\n\n    padding: 34px 14px;\n  }\n\n  .ms-specs__grid {\n\n    grid-template-columns: 1fr;\n  }\n\n\n  .ms-final-cta {\n\n    margin-top: 40px;\n\n    padding: 35px 19px;\n  }\n\n  .ms-final-trust {\n\n    grid-template-columns: repeat(2,1fr);\n  }\n\n}\n\n\n/* ========================================================\n   PETITS MOBILES\n======================================================== */\n\n@media screen and (max-width: 390px) {\n\n  .ms-benefits,\n  .ms-install-steps {\n\n    grid-template-columns: 1fr;\n  }\n\n}\n\n</style>",
