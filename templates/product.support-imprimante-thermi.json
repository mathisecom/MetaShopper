iv>\n\n    <!-- STABILITÉ -->\n    <div class=\"ms-product-benefits__item\">\n      <span class=\"ms-product-benefits__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M5 17h14\"/>\n          <path d=\"M7 17V8h10v9\"/>\n          <path d=\"M4 20h16\"/>\n          <path d=\"M9 8V5h6v3\"/>\n        </svg>\n      </span>\n      <span class=\"ms-product-benefits__content\">\n        <strong>Support stable</strong>\n        <small>Un poste d’expédition plus propre et ordonné</small>\n      </span>\n    </div>\n\n    <!-- INSTALLATION SIMPLE -->\n    <div class=\"ms-product-benefits__item\">\n      <span class=\"ms-product-benefits__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M12 3v12\"/>\n          <path d=\"m8 11 4 4 4-4\"/>\n          <path d=\"M5 18h14v3H5z\"/>\n        </svg>\n      </span>\n      <span class=\"ms-product-benefits__content\">\n        <strong>Prêt à l’emploi</strong>\n        <small>Posez, chargez vos étiquettes et imprimez</small>\n      </span>\n    </div>\n\n    <!-- COMPATIBILITÉ -->\n    <div class=\"ms-product-benefits__item\">\n      <span class=\"ms-product-benefits__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M6 9V4h12v5\"/>\n          <rect x=\"4\" y=\"9\" width=\"16\" height=\"8\" rx=\"2\"/>\n          <path d=\"M7 17v4h10v-4\"/>\n          <path d=\"M8 13h1\"/>\n        </svg>\n      </span>\n      <span class=\"ms-product-benefits__content\">\n        <strong>Compatible imprimantes thermiques</strong>\n        <small>Le complément idéal de votre espace d’expédition</small>\n      </span>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .ms-product-benefits {\n    /* COULEURS METASHOPPER */\n    --ms-benefit-background: #F7F7F9;\n    --ms-benefit-text: #1f1f1f;\n    --ms-benefit-icon: #ff4713;\n\n    /* DIMENSIONS */\n    --ms-benefit-radius: 2px;\n    --ms-benefit-gap: 12px;\n    --ms-benefit-icon-size: 32px;\n    --ms-benefit-title-size: 14px;\n    --ms-benefit-description-size: 12px;\n\n    width: 100%;\n    margin: 18px 0;\n  }\n\n  .ms-product-benefits,\n  .ms-product-benefits * {\n    box-sizing: border-box;\n  }\n\n  .ms-product-benefits__grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: var(--ms-benefit-gap);\n  }\n\n  .ms-product-benefits__item {\n    min-width: 0;\n    min-height: 72px;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 13px 15px;\n    background: var(--ms-benefit-background);\n    color: var(--ms-benefit-text);\n    border-radius: var(--ms-benefit-radius);\n  }\n\n  .ms-product-benefits__icon {\n    width: var(--ms-benefit-icon-size);\n    height: var(--ms-benefit-icon-size);\n    flex: 0 0 var(--ms-benefit-icon-size);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--ms-benefit-icon);\n  }\n\n  .ms-product-benefits__icon svg {\n    width: 100%;\n    height: 100%;\n    display: block;\n    stroke: currentColor;\n    stroke-width: 1.65;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .ms-product-benefits__content {\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 3px;\n    line-height: 1.25;\n  }\n\n  .ms-product-benefits__content strong {\n    display: block;\n    margin: 0;\n    color: var(--ms-benefit-text);\n    font-size: var(--ms-benefit-title-size);\n    font-weight: 650;\n  }\n\n  .ms-product-benefits__content small {\n    display: block;\n    margin: 0;\n    color: var(--ms-benefit-text);\n    font-size: var(--ms-benefit-description-size);\n    line-height: 1.3;\n    opacity: 0.72;\n  }\n\n  @media screen and (max-width: 989px) {\n    .ms-product-benefits__grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .ms-product-benefits {\n      --ms-benefit-gap: 8px;\n      --ms-benefit-icon-size: 29px;\n      --ms-benefit-title-size: 13px;\n      --ms-benefit-description-size: 11px;\n      margin: 14px 0;\n    }\n\n    .ms-product-benefits__grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      align-items: start;\n      gap: 6px;\n    }\n\n    .ms-product-benefits__item {\n      min-height: 0;\n      height: auto;\n      padding: 7px;\n      gap: 6px;\n      align-items: flex-start;\n    }\n\n    .ms-product-benefits__icon {\n      width: 23px;\n      height: 23px;\n      flex-basis: 23px;\n    }\n\n    .ms-product-benefits__content {\n      gap: 1px;\n    }\n\n    .ms-product-benefits__content strong {\n      font-size: 11.5px;\n      line-height: 1.15;\n    }\n\n    .ms-product-benefits__content small {\n      font-size: 10px;\n      line-height: 1.18;\n    }\n  }\n</style>"
