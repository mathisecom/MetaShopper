    "custom_liquid_M9DGKt": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "{% comment %}\n===========================================================\nMETASHOPPER\nSUPPORT POUR ROULEAU D'ÉTIQUETTES THERMIQUES\nVERSION CDN SHOPIFY — IMAGES DIRECTES\n===========================================================\n{% endcomment %}\n\n<div class=\"ms-holder-page\" id=\"ms-holder-page\">\n\n  <!-- =====================================================\n       1 — HERO\n  ====================================================== -->\n\n  <section class=\"ms-holder-hero\">\n\n    <div class=\"ms-holder-hero__content\">\n\n      <span class=\"ms-kicker\">\n        ACCESSOIRE POUR IMPRIMANTE THERMIQUE\n      </span>\n\n      <h2>\n        Le support d'étiquettes qui\n        <span>simplifie vos expéditions</span>\n      </h2>\n\n      <p class=\"ms-lead\">\n        Gardez votre rouleau d'étiquettes thermiques correctement\n        positionné à proximité de votre imprimante et profitez d'un\n        poste d'expédition plus propre, plus pratique et mieux organisé.\n      </p>\n\n      <div class=\"ms-hero-points\">\n\n        <div class=\"ms-hero-point\">\n          <span class=\"ms-check\">✓</span>\n          <div>\n            <strong>Déroulement régulier</strong>\n            <small>Le rouleau accompagne naturellement vos impressions.</small>\n          </div>\n        </div>\n\n        <div class=\"ms-hero-point\">\n          <span class=\"ms-check\">✓</span>\n          <div>\n            <strong>Format 100 × 150 mm</strong>\n            <small>Idéal pour votre poste d'expédition 4×6.</small>\n          </div>\n        </div>\n\n        <div class=\"ms-hero-point\">\n          <span class=\"ms-check\">✓</span>\n          <div>\n            <strong>Installation immédiate</strong>\n            <small>Aucun câble, Bluetooth ou alimentation électrique.</small>\n          </div>\n        </div>\n\n      </div>\n\n      <button\n        type=\"button\"\n        class=\"ms-main-button\"\n        onclick=\"window.scrollTo({top:0,behavior:'smooth'});\"\n      >\n        Choisir mon support\n        <span>↑</span>\n      </button>\n\n      <div class=\"ms-trust\">\n        <span>🚚 Livraison 24/48 h</span>\n        <span>✓ Garantie 2 ans</span>\n        <span>↩ Retours 30 jours</span>\n        <span>◉ SAV 24/7</span>\n      </div>\n\n    </div>\n\n\n    <div class=\"ms-holder-hero__image\">\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/1011/7126/5861/files/support-etiquettes-hero_webp.png?v=1789005292\"\n        alt=\"Support pour rouleau d'étiquettes thermiques avec imprimante thermique Metashopper\"\n        width=\"1400\"\n        height=\"1200\"\n        loading=\"eager\"\n        fetchpriority=\"high\"\n      >\n\n    </div>\n\n  </section>\n\n\n  <!-- =====================================================\n       2 — 4 BÉNÉFICES\n  ====================================================== -->\n\n  <section class=\"ms-section\">\n\n    <div class=\"ms-heading\">\n\n      <span class=\"ms-kicker\">\n        PENSÉ POUR VOS EXPÉDITIONS\n      </span>\n\n      <h2>\n        Un petit accessoire qui améliore\n        <span>votre poste d'impression</span>\n      </h2>\n\n      <p>\n        Gardez vos étiquettes accessibles et créez un chemin\n        d'alimentation plus propre entre votre rouleau et votre imprimante.\n      </p>\n\n    </div>\n\n\n    <div class=\"ms-benefits\">\n\n      <article class=\"ms-benefit\">\n\n        <div class=\"ms-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <circle cx=\"8\" cy=\"12\" r=\"5\"/>\n            <circle cx=\"8\" cy=\"12\" r=\"1.5\"/>\n            <path d=\"M13 12h8\"/>\n            <path d=\"m18 8 4 4-4 4\"/>\n          </svg>\n        </div>\n\n        <h3>Déroulement fluide</h3>\n\n        <p>\n          Le rouleau peut tourner librement pendant vos impressions.\n        </p>\n\n      </article>\n\n\n      <article class=\"ms-benefit\">\n\n        <div class=\"ms-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M5 19h14\"/>\n            <path d=\"M7 19V8h10v11\"/>\n            <path d=\"M9 8V5h6v3\"/>\n          </svg>\n        </div>\n\n        <h3>Rouleau maintenu</h3>\n\n        <p>\n          Gardez vos étiquettes correctement positionnées près de l'imprimante.\n        </p>\n\n      </article>\n\n\n      <article class=\"ms-benefit\">\n\n        <div class=\"ms-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"1.5\"/>\n            <path d=\"M8 7h8M8 11h8M8 15h5\"/>\n          </svg>\n        </div>\n\n        <h3>Format 100 × 150 mm</h3>\n\n        <p>\n          Idéal pour organiser vos étiquettes d'expédition 4×6.\n        </p>\n\n      </article>\n\n\n      <article class=\"ms-benefit\">\n\n        <div class=\"ms-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M4 19h16\"/>\n            <path d=\"M6 19V9h12v10\"/>\n            <path d=\"M9 9V6h6v3\"/>\n          </svg>\n        </div>\n\n        <h3>Poste organisé</h3>\n\n        <p>\n          Un espace d'impression plus propre pour préparer vos commandes.\n        </p>\n\n      </article>\n\n    </div>\n\n  </section>\n\n\n  <!-- =====================================================\n       3 — DÉROULEMENT\n  ====================================================== -->\n\n  <section class=\"ms-section ms-split\">\n\n    <div class=\"ms-split__image\">\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/1011/7126/5861/files/support-etiquettes-deroulement.png?v=1789004931\"\n        alt=\"Déroulement d'un rouleau d'étiquettes thermiques sur son support\"\n        width=\"1200\"\n        height=\"1000\"\n        loading=\"lazy\"\n      >\n\n    </div>\n\n\n    <div class=\"ms-split__content\">\n\n      <span class=\"ms-kicker\">\n        ALIMENTATION DES ÉTIQUETTES\n      </span>\n\n      <h2>\n        Un déroulement\n        <span>simple et régulier</span>\n      </h2>\n\n      <p>\n        Installez votre rouleau sur son axe puis positionnez\n        le support dans l'alignement de votre imprimante thermique.\n        Les étiquettes restent immédiatement disponibles au fil\n        de vos impressions.\n      </p>\n\n\n      <div class=\"ms-feature-lines\">\n\n        <div>\n          <span>01</span>\n          <p>\n            <strong>Rouleau maintenu</strong>\n            <small>Votre consommable reste correctement positionné.</small>\n          </p>\n        </div>\n\n        <div>\n          <span>02</span>\n          <p>\n            <strong>Alimentation directe</strong>\n            <small>La bande est orientée vers votre imprimante.</small>\n          </p>\n        </div>\n\n        <div>\n          <span>03</span>\n          <p>\n            <strong>Moins de manipulations</strong>\n            <small>Vos étiquettes restent à portée de main.</small>\n          </p>\n        </div>\n\n        <div>\n          <span>04</span>\n          <p>\n            <strong>Aucun paramétrage</strong>\n            <small>Posez, installez et utilisez.</small>\n          </p>\n        </div>\n\n      </div>\n\n    </div>\n\n  </section>\n\n\n  <!-- =====================================================\n       4 — POSTE D'EXPÉDITION\n  ====================================================== -->\n\n  <section class=\"ms-section ms-split ms-split--reverse\">\n\n    <div class=\"ms-split__image\">\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/1011/7126/5861/files/support-etiquettes-expedition.png?v=1789004931\"\n        alt=\"Poste d'expédition e-commerce avec support pour étiquettes thermiques\"\n        width=\"1200\"\n        height=\"1000\"\n        loading=\"lazy\"\n      >\n\n    </div>\n\n\n    <div class=\"ms-split__content\">\n\n      <span class=\"ms-kicker\">\n        POUR VOTRE ACTIVITÉ E-COMMERCE\n      </span>\n\n      <h2>\n        Transformez votre bureau en\n        <span>véritable poste d'expédition</span>\n     