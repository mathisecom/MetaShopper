4\" fill=\"none\">\n          <path d=\"M5 8h14l2 12H3L5 8Z\"/>\n          <path d=\"M8 8a4 4 0 0 1 8 0\"/>\n          <path d=\"M9 14h6\"/>\n        </svg>\n      </span>\n      <span class=\"ms-product-benefits__content\">\n        <strong>Fonction tare</strong>\n        <small>Déduisez le poids de l’emballage</small>\n      </span>\n    </div>\n\n    <!-- COMPACTE -->\n    <div class=\"ms-product-benefits__item\">\n      <span class=\"ms-product-benefits__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <rect x=\"4\" y=\"7\" width=\"16\" height=\"11\" rx=\"2\"/>\n          <path d=\"M8 4h8M12 4v3\"/>\n          <path d=\"M8 13h8\"/>\n        </svg>\n      </span>\n      <span class=\"ms-product-benefits__content\">\n        <strong>Format compact</strong>\n        <small>Facile à intégrer à votre bureau</small>\n      </span>\n    </div>\n\n    <!-- E-COMMERCE -->\n    <div class=\"ms-product-benefits__item\">\n      <span class=\"ms-product-benefits__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M3 6h11v11H3V6Zm11 4h4l3 3v4h-7v-7Z\"/>\n          <circle cx=\"7\" cy=\"18\" r=\"2\"/>\n          <circle cx=\"18\" cy=\"18\" r=\"2\"/>\n        </svg>\n      </span>\n      <span class=\"ms-product-benefits__content\">\n        <strong>E-commerce & expédition</strong>\n        <small>Vinted, Shopify, Amazon, colis</small>\n      </span>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .ms-product-benefits {\n    --ms-benefit-background: #F7F7F9;\n    --ms-benefit-text: #1f1f1f;\n    --ms-benefit-icon: #ff4713;\n\n    --ms-benefit-radius: 2px;\n    --ms-benefit-gap: 12px;\n    --ms-benefit-icon-size: 32px;\n    --ms-benefit-title-size: 14px;\n    --ms-benefit-description-size: 12px;\n\n    width: 100%;\n    margin: 18px 0;\n  }\n\n  .ms-product-benefits,\n  .ms-product-benefits * {\n    box-sizing: border-box;\n  }\n\n  .ms-product-benefits__grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: var(--ms-benefit-gap);\n  }\n\n  .ms-product-benefits__item {\n    min-width: 0;\n    min-height: 72px;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 13px 15px;\n    background: var(--ms-benefit-background);\n    color: var(--ms-benefit-text);\n    border-radius: var(--ms-benefit-radius);\n  }\n\n  .ms-product-benefits__icon {\n    width: var(--ms-benefit-icon-size);\n    height: var(--ms-benefit-icon-size);\n    flex: 0 0 var(--ms-benefit-icon-size);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--ms-benefit-icon);\n  }\n\n  .ms-product-benefits__icon svg {\n    width: 100%;\n    height: 100%;\n    display: block;\n    stroke: currentColor;\n    stroke-width: 1.65;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .ms-product-benefits__content {\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 3px;\n    line-height: 1.25;\n  }\n\n  .ms-product-benefits__content strong {\n    display: block;\n    margin: 0;\n    color: var(--ms-benefit-text);\n    font-size: var(--ms-benefit-title-size);\n    font-weight: 650;\n  }\n\n  .ms-product-benefits__content small {\n    display: block;\n    margin: 0;\n    color: var(--ms-benefit-text);\n    font-size: var(--ms-benefit-description-size);\n    line-height: 1.3;\n    opacity: 0.72;\n  }\n\n  @media screen and (max-width: 989px) {\n    .ms-product-benefits__grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .ms-product-benefits {\n      --ms-benefit-gap: 8px;\n      --ms-benefit-icon-size: 29px;\n      --ms-benefit-title-size: 13px;\n      --ms-benefit-description-size: 11px;\n      margin: 14px 0;\n    }\n\n    .ms-product-benefits__grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 6px;\n    }\n\n    .ms-product-benefits__item {\n      min-height: 0;\n      padding: 7px;\n      gap: 6px;\n      align-items: flex-start;\n    }\n\n    .ms-product-benefits__icon {\n      width: 23px;\n      height: 23px;\n      flex-basis: 23px;\n    }\n\n    .ms-product-benefits__content {\n      gap: 1px;\n    }\n\n    .ms-product-benefits__content strong {\n      font-size: 11.5px;\n      line-height: 1.15;\n    }\n\n    .ms-product-benefits__content small {\n      font-size: 10px;\n      line-height: 1.18;\n    }\n  }\n</style>"
