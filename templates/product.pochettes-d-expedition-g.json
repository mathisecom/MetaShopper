        "liquid_xRQDHD": {
          "type": "liquid",
          "settings": {
            "liquid": "{% comment %}\n  ============================================================\n  BUNDLE 3 PACKS (Starter / Business / Business Pro) + COULEUR\n  Version LIQUID — à coller dans un bloc \"Custom Liquid\" de ta\n  fiche produit, positionné AU-DESSUS du bouton \"Ajouter au\n  panier\" du thème.\n\n  ✅ FIX (28/07/2026) : le bouton restait figé en \"chargement\"\n  après un ajout réussi si le client fermait le panier plutôt\n  que de continuer son shopping. On réactive maintenant le\n  bouton dès que le tiroir panier s'est ouvert.\n  ============================================================\n{% endcomment %}\n\n{% assign pack_names = \"Starter,Business,Business Pro\" | split: \",\" %}\n{% assign pack_labels = \"PACK STARTER,PACK BUSINESS,PACK BUSINESS PRO\" | split: \",\" %}\n{% assign pack_subs = \"Imprimante + 200 étiquettes offertes,Imprimante + 500 étiquettes + Support + \n 5 Pochettes,Imprimante + 1000 étiquettes + Support + 10 Pochettes\" | split: \",\" %}\n\n<div class=\"msb-wrapper\" data-product-handle=\"{{ product.handle }}\">\n\n  <div class=\"msb-color-block\">\n    <div class=\"msb-color-label\">Couleur : <span class=\"msb-color-selected\"></span></div>\n    <div class=\"msb-colors\" role=\"radiogroup\" aria-label=\"Choix de la couleur\">\n      {% assign seen_colors = \"\" %}\n      {% for variant in product.variants %}\n        {% unless seen_colors contains variant.option1 %}\n          {% assign seen_colors = seen_colors | append: variant.option1 | append: \",\" %}\n          <label class=\"msb-swatch\"\n                 data-color=\"{{ variant.option1 }}\"\n                 style=\"--swatch-color:\n                   {% case variant.option1 %}\n                     {% when 'Noir' %}#1a1a1a\n                     {% when 'Rose' %}#f4a6b7\n                     {% when 'Blanc' %}#f2f2f2\n                     {% else %}#cccccc\n                   {% endcase %};\">\n            <input type=\"radio\" name=\"msb-color\" value=\"{{ variant.option1 }}\" {% if forloop.first %}checked{% endif %}>\n          </label>\n        {% endunless %}\n      {% endfor %}\n    </div>\n  </div>\n\n  <div class=\"msb-title\">CHOISISSEZ VOTRE PACK</div>\n\n  <div class=\"msb-bars\" role=\"radiogroup\" aria-label=\"Choix du pack\">\n    {% for pack_name in pack_names %}\n      {% assign pack_index = forloop.index0 %}\n      {% assign matched_variant = null %}\n      {% for variant in product.variants %}\n        {% if variant.option2 == pack_name %}\n          {% assign matched_variant = variant %}\n          {% break %}\n        {% endif %}\n      {% endfor %}\n\n      {% if matched_variant %}\n        <label class=\"msb-bar {% if pack_name == 'Business' %}msb-bar--popular{% elsif pack_name == 'Business Pro' %}msb-bar--best{% endif %}\"\n               data-pack=\"{{ pack_name }}\">\n          <input type=\"radio\" name=\"msb-pack\" value=\"{{ pack_name }}\" {% if pack_name == 'Business' %}checked{% endif %}>\n          {% if pack_name == 'Business' %}\n            <span class=\"msb-badge msb-badge--popular\">LE PLUS POPULAIRE</span>\n          {% elsif pack_name == 'Business Pro' %}\n            <span class=\"msb-badge\">MEILLEUR CHOIX</span>\n          {% endif %}\n          <div class=\"msb-bar-inner\">\n            <img class=\"msb-bar-img\" src=\"{% case pack_name %}{% when 'Business' %}https://cdn.shopify.com/s/files/1/1011/7126/5861/files/1784902591Rapi-Bundles-icone_8.png?v=1784902595{% when 'Business Pro' %}https://cdn.shopify.com/s/files/1/1011/7126/5861/files/1784903499Rapi-Bundles-icone_9.png?v=1784903502{% else %}{{ matched_variant.featured_image.src | default: product.featured_image.src | image_url: width: 200 }}{% endcase %}\" alt=\"{{ pack_labels[pack_index] }}\">\n            <div class=\"msb-bar-content\">\n              <div class=\"msb-bar-top\">\n                <span class=\"msb-bar-name\">{{ pack_labels[pack_index] }}</span>\n                {% if pack_name == 'Starter' %}<span class=\"msb-bar-tag\">PARFAIT POUR DÉBUTER</span>{% endif %}\n              </div>\n              <div class=\"msb-bar-sub\">{{ pack_subs[pack_index] }}</div>\n            </div>\n            <div class=\"msb-bar-price\">\n              <span class=\"msb-price\">{{ matched_variant.price | money }}</span>\n              {% if matched_variant.compare_at_price > matched_variant.price %}\n                <span class=\"msb-compare\">{{ matched_variant.compare_at_price | money }}</span>\n              {% endif %}\n            </div>\n          </div>\n        </label>\n      {% endif %}\n    {% endfor %}\n  </div>\n\n  <button type=\"button\" class=\"msb-add-btn\" id=\"msb-add-to-cart\">\n    <span class=\"msb-add-btn__label\">Ajouter au panier</span>\n    <span class=\"msb-add-btn__price\"></span>\n    <span class=\"msb-add-btn__loader\" style=\"display:none;\">...</span>\n  </button>\n\n  <div class=\"msb-error\" style=\"display:none;\"></div>\n</div>\n\n<style>\n  .msb-wrapper {\n    --msb-accent: #ff4713;\n    --msb-accent-bg: #ff471305;\n    --msb-border: #ff47137a;\n    --msb-border-selected: #ff4713ff;\n    --msb-radius: 6px;\n    font-family: inherit;\n    margin: 10px 0;\n  }\n  .msb-wrapper * { box-sizing: border-box; }\n\n  .msb-color-block { margin-bottom: 14px; }\n  .msb-color-label { font-size: 12px; font-weight: 600; color: #333; margin-bottom: 6px; }\n  .msb-color-selected { font-weight: 700; color: var(--msb-accent); }\n  .msb-colors { display: flex; gap: 10px; }\n\n  .msb-swatch {\n    position: relative;\n    width: 32px; height: 32px;\n    border-radius: 50%;\n    background: var(--swatch-color);\n    border: 2px solid #ddd;\n    cursor: pointer;\n    display: block;\n  }\n  .msb-swatch[data-color=\"Blanc\"] { border-color: #ccc; }\n  .msb-swatch input { position: absolute; opacity: 0; width: 0; height: 0; }\n  .msb-swatch:has(input:checked) {\n    border-color: var(--msb-accent);\n    box-shadow: 0 0 0 2px #fff, 0 0 0 3.5px var(--msb-accent);\n  }\n\n  .msb-title { font-size: 13px; font-weight: 700; text-align: center; margin-bottom: 8px; color: #000; }\n  .msb-bars { display: flex; flex-direction: column; gap: 8px; }\n\n  .msb-bar {\n    position: relative;\n    display: block;\n    border: 2px solid var(--msb-border);\n    border-radius: var(--msb-radius);\n    background: #fff;\n    cursor: pointer;\n    padding: 2px;\n    transition: box-shadow .15s ease, border-color .15s ease, background .15s ease;\n  }\n  .msb-bar input[type=\"radio\"] { position: absolute; opacity: 0; width: 0; height: 0; }\n\n  .msb-bar-inner { display: flex; align-items: center; gap: 12px; padding: 10px 16px; }\n  .msb-bar-img { width: 52px; height: 52px; object-fit: contain; border-radius: 5px; flex-shrink: 0; }\n  .msb-bar-content { flex: 1; min-width: 0; }\n  .msb-bar-top { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin-bottom: 2px; }\n  .msb-bar-name { font-size: 12px; font-weight: 700; color: #000; }\n  .msb-bar-tag {\n    font-size: 10px; font-weight: 400; color: var(--msb-accent);\n    background: rgba(255, 71, 19, 0.17); padding: 2px 6px; border-radius: 3px; white-space: nowrap;\n  }\n  .msb-bar-sub { font-size: 11px; color: #777; }\n  .msb-bar-price { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; white-space: nowrap; }\n  .msb-price { font-size: 13px; font-weight: 700; color: var(--msb-accent); }\n  .msb-compare { font-size: 11px; color: #6B7280; text-decoration: line-through; }\n\n  .msb-badge {\n    position: absolute; top: -11px; left: 16px;\n    background: var(--msb-accent); color: #fff;\n    font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 4px; z-index: 2;\n  }\n  .msb-badge--popular { background: #1a1a1a; }\n\n  .msb-bar:has(input:checked) {\n    border-color: var(--msb-border-selected);\n    background: var(--msb-accent-bg);\n    box-shadow: 0 0 0 1px var(--msb-border-selected) inset;\n  }\n  .msb-bar:hover { border-color: var(--msb-border-selected); }\n\n  .msb-add-btn {\n    width: 100%;\n    margin-top: 14px;\n    padding: 14px 20px;\n    background: var(--msb-accent);\n    color: #fff;\n    font-size: 15px;\n    font-weight: 700;\n    border: none;\n    border-radius: var(--msb-radius);\n    cursor: pointer;\n    transition: opacity .15s ease;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n  }\n  .msb-add-btn__price {\n    font-weight: 700;\n    opacity: 0.92;\n  }\n  .msb-add-btn__price::before {\n    content: \"·\";\n    margin-right: 8px;\n    opacity: 0.7;\n  }\n  .msb-add-btn:hover { opacity: 0.9; }\n  .msb-add-btn:disabled { opacity: 0.6; cursor: not-allowed; }\n\n  .msb-error {\n    margin-top: 8px; padding: 8px 12px;\n    background: #fff4f2; border: 1px solid #ff9d86; border-radius: 6px;\n    color: #b3300f; font-size: 12px;\n  }\n\n  @media screen and (max-width: 480px) {\n    .msb-bar-inner { padding: 8px 12px; gap: 10px; }\n    .msb-bar-img { width: 44px; height: 44px; }\n    .msb-bar-name { font-size: 11.5px; }\n    .msb-bar-sub { font-size: 10.5px; }\n  }\n</style>\n\n<script>\n  (function () {\n    var PRODUCT_VARIANTS = {{ product.variants | json }};\n    var MONEY_FORMAT = {{ shop.money_format | json }};\n\n    function formatMoney(cents) {\n      function withDelimiters(number, precision, thousands, decimal) {\n        number = (number / 100).toFixed(precision);\n        var parts = number.split('.');\n        var dollars = parts[0].replace(/(\\d)(?=(\\d\\d\\d)+(?!\\d))/g, '$1' + thousands);\n        var rest = parts[1] ? decimal + parts[1] : '';\n        return dollars + rest;\n      }\n      var placeholderMatch = MONEY_FORMAT.match(/\\{\\{\\s*(\\w+)\\s*\\}\\}/);\n      var key = placeholderMatch ? placeholderMatch[1] : 'amount_with_comma_separator';\n      var value;\n      switch (key) {\n        case 'amount':\n          value = withDelimiters(cents, 2, ',', '.');\n          break;\n        case 'amount_no_decimals':\n          value = withDelimiters(cents, 0, ',', '.');\n          break;\n        case 'amount_no_decimals_with_comma_separator':\n          value = withDelimiters(cents, 0, '.', ',');\n          break;\n        case 'amount_with_comma_separator':\n        default:\n          value = withDelimiters(cents, 2, '.', ',');\n      }\n      return MONEY_FORMAT.replace(/\\{\\{\\s*\\w+\\s*\\}\\}/, value);\n    }\n\n    var wrapper = document.currentScript.closest('.msb-wrapper') ||\n                  document.querySelector('.msb-wrapper[data-product-handle=\"{{ product.handle }}\"]');\n\n    var colorLabel = wrapper.querySelector('.msb-color-selected');\n    var addBtn = wrapper.querySelector('#msb-add-to-cart');\n    var btnLabel = addBtn.querySelector('.msb-add-btn__label');\n    var btnPrice = addBtn.querySelector('.msb-add-btn__price');\n    var btnLoader = addBtn.querySelector('.msb-add-btn__loader');\n    var errorBox = wrapper.querySelector('.msb-error');\n\n    function getSelectedColor() {\n      var el = wrapper.querySelector('input[name=\"msb-color\"]:checked');\n      return el ? el.value : null;\n    }\n    function getSelectedPack() {\n      var el = wrapper.querySelector('input[name=\"msb-pack\"]:checked');\n      return el ? el.value : null;\n    }\n\n    function findVariant(color, pack) {\n      for (var i = 0; i < PRODUCT_VARIANTS.length; i++) {\n        var v = PRODUCT_VARIANTS[i];\n        if (v.option1 === color && v.option2 === pack) return v;\n      }\n      return null;\n    }\n\n    function refreshLabel() {\n      var color = getSelectedColor();\n      if (colorLabel && color) colorLabel.textContent = color;\n    }\n\n    function updateButtonPrice() {\n      var color = getSelectedColor();\n      var pack = getSelectedPack();\n      var variant = findVariant(color, pack);\n      if (variant && btnPrice) {\n        btnPrice.textContent = formatMoney(variant.price);\n      } else if (btnPrice) {\n        btnPrice.textContent = '';\n      }\n    }\n\n    function showError(msg) {\n      errorBox.textContent = msg;\n      errorBox.style.display = 'block';\n    }\n    function hideError() {\n      errorBox.style.display = 'none';\n    }\n\n    function setLoading(isLoading) {\n      addBtn.disabled = isLoading;\n      btnLabel.style.display = isLoading ? 'none' : 'inline';\n      btnPrice.style.display = isLoading ? 'none' : 'inline';\n      btnLoader.style.display = isLoading ? 'inline' : 'none';\n    }\n\n    async function addToCart() {\n      hideError();\n      var color = getSelectedColor();\n      var pack = getSelectedPack();\n      var variant = findVariant(color, pack);\n\n      if (!variant) {\n        showError('Cette combinaison (' + color + ' / ' + pack + ') n\\'existe pas. Vérifie tes variantes Shopify.');\n        return;\n      }\n      if (!variant.available) {\n        showError('Ce pack (' + color + ' / ' + pack + ') est actuellement en rupture de stock.');\n        return;\n      }\n\n      setLoading(true);\n      try {\n        var res = await fetch('/cart/add.js', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },\n          body: JSON.stringify({ items: [{ id: variant.id, quantity: 1 }] })\n        });\n\n        if (!res.ok) {\n          var errData = await res.json().catch(function () { return {}; });\n          throw new Error(errData.description || 'Erreur lors de l\\'ajout au panier.');\n        }\n\n        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));\n        document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));\n\n        var opened = await openCartDrawer();\n        if (!opened) {\n          window.location.href = '/cart';\n          return;\n        }\n\n        // ✅ FIX : on réactive le bouton après un ajout réussi et\n        // l'ouverture du panier, pour qu'il reste utilisable.\n        setLoading(false);\n\n      } catch (err) {\n        showError(err.message || 'Une erreur est survenue.');\n        setLoading(false);\n      }\n    }\n\n    async function openCartDrawer() {\n      var prestigeDrawer = document.querySelector('cart-drawer');\n      if (prestigeDrawer) {\n        try {\n          if (typeof prestigeDrawer.refetchContents === 'function') {\n            await prestigeDrawer.refetchContents();\n          }\n        } catch (e) { /* on tente quand même l'ouverture */ }\n\n        if (prestigeDrawer.dialog && typeof prestigeDrawer.dialog.showModal === 'function') {\n          prestigeDrawer.dialog.showModal();\n          return true;\n        }\n        if (typeof prestigeDrawer.show === 'function') {\n          prestigeDrawer.show();\n          return true;\n        }\n        if (typeof prestigeDrawer.open === 'function') {\n          prestigeDrawer.open();\n          return true;\n        }\n      }\n\n      var drawer = document.querySelector(\n        '#cart-drawer, .cart-drawer, [data-cart-drawer]'\n      );\n      if (drawer) {\n        if (typeof drawer.open === 'function') {\n          drawer.open();\n          return true;\n        }\n        if (typeof drawer.renderContents === 'function') {\n          try {\n            var cart = await fetch('/cart.js').then(function (r) { return r.json(); });\n            drawer.renderContents(cart);\n          } catch (e) { /* on ouvre quand même */ }\n        }\n        drawer.classList.add('active', 'is-open', 'open', 'drawer--open');\n        drawer.removeAttribute('hidden');\n        return true;\n      }\n\n      var cartIcon = document.querySelector(\n        '#cart-icon-bubble, [data-cart-drawer-toggle], .header__icon--cart, ' +\n        '.cart-icon, .js-cart-drawer-toggle, a[href=\"/cart\"]'\n      );\n      if (cartIcon) {\n        cartIcon.click();\n        return true;\n      }\n\n      return false;\n    }\n\n    wrapper.querySelectorAll('input[name=\"msb-color\"], input[name=\"msb-pack\"]')\n      .forEach(function (input) {\n        input.addEventListener('change', function () {\n          hideError();\n          refreshLabel();\n          updateButtonPrice();\n        });\n      });\n\n    addBtn.addEventListener('click', addToCart);\n\n    refreshLabel();\n    updateButtonPrice();\n  })();\n</script>"
          }
        },
