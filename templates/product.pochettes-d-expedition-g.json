    "custom_liquid_fmyDLH": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "{% comment %}\n  ==========================================================\n  METASHOPPER — POCHETTES D’EXPÉDITION GRISES\n  PACK DE 30 — S / M / L\n  SEO / GEO / CONVERSION\n\n  Compatible avec Shopify « Liquid personnalisé »\n\n  DONNÉES À COMPLÉTER UNE FOIS CONFIRMÉES :\n{% endcomment %}\n\n{% assign ms_size_s = '' %}\n{% assign ms_size_m = '' %}\n{% assign ms_size_l = '' %}\n{% assign ms_material = '' %}\n\n{% assign ms_labels = all_products['metashopper-etiquettes-thermiques-100x150'] %}\n{% assign ms_printer = all_products['metashopper-imprimante-thermique-bluetooth'] %}\n{% assign ms_scale = all_products['balance-colis-digitale'] %}\n{% assign ms_support = all_products['support-detiquettes-thermique'] %}\n\n<div class=\"ms-pouch-page\">\n\n\n  <!-- =====================================================\n       1. EMBALLEZ, FERMEZ, EXPÉDIEZ\n  ====================================================== -->\n\n  <section class=\"msp-hero\">\n\n    <div class=\"msp-hero__media\">\n\n      {% if product.images[1] %}\n        {{\n          product.images[1]\n          | image_url: width: 1400\n          | image_tag:\n            loading: 'lazy',\n            widths: '500, 800, 1100, 1400',\n            sizes: '(min-width: 990px) 50vw, 100vw',\n            alt: 'Pochette d’expédition grise auto-adhésive pour colis e-commerce'\n        }}\n      {% elsif product.featured_image %}\n        {{\n          product.featured_image\n          | image_url: width: 1400\n          | image_tag:\n            loading: 'lazy',\n            widths: '500, 800, 1100, 1400',\n            sizes: '(min-width: 990px) 50vw, 100vw',\n            alt: 'Pochette d’expédition grise auto-adhésive pour colis e-commerce'\n        }}\n      {% endif %}\n\n    </div>\n\n\n    <div class=\"msp-hero__content\">\n\n      <span class=\"msp-kicker\">EMBALLAGE E-COMMERCE</span>\n\n      <h2>Emballez, fermez, expédiez</h2>\n\n      <p class=\"msp-hero__lead\">\n        Préparez vos commandes rapidement avec une\n        <strong>pochette opaque et auto-adhésive</strong>,\n        conçue pour protéger vos articles pendant leur expédition.\n      </p>\n\n      <p>\n        Insérez votre article, retirez la bande de protection puis refermez\n        la pochette. Il ne vous reste plus qu’à apposer votre étiquette\n        d’expédition avant la remise au transporteur.\n      </p>\n\n      <div class=\"msp-checks\">\n\n        <div>\n          <span>✓</span>\n          <small>Fermeture rapide sans ruban supplémentaire</small>\n        </div>\n\n        <div>\n          <span>✓</span>\n          <small>Contenu masqué grâce à la matière opaque</small>\n        </div>\n\n        <div>\n          <span>✓</span>\n          <small>Surface pratique pour votre étiquette colis</small>\n        </div>\n\n      </div>\n\n    </div>\n\n  </section>\n\n\n\n  <!-- =====================================================\n       2. BÉNÉFICES VENDEURS\n  ====================================================== -->\n\n  <section class=\"msp-section\">\n\n    <div class=\"msp-heading\">\n\n      <span class=\"msp-kicker\">PRÉPARATION DE COMMANDES</span>\n\n      <h2>Un emballage pensé pour les vendeurs en ligne</h2>\n\n      <p>\n        Un emballage simple à intégrer à votre poste de préparation\n        pour gagner du temps sur les commandes du quotidien.\n      </p>\n\n    </div>\n\n\n    <div class=\"msp-benefits\">\n\n\n      <article class=\"msp-benefit\">\n\n        <div class=\"msp-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M4 7h16v12H4V7Z\"/>\n            <path d=\"m4 7 8 6 8-6\"/>\n            <path d=\"M8 4h8\"/>\n          </svg>\n        </div>\n\n        <h3>Fermez sans ruban</h3>\n\n        <p>\n          La bande auto-adhésive permet de fermer rapidement votre pochette.\n        </p>\n\n      </article>\n\n\n\n      <article class=\"msp-benefit\">\n\n        <div class=\"msp-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M3 12s3-5 9-5 9 5 9 5-3 5-9 5-9-5-9-5Z\"/>\n            <circle cx=\"12\" cy=\"12\" r=\"2.5\"/>\n            <path d=\"M4 4 20 20\"/>\n          </svg>\n        </div>\n\n        <h3>Préservez la confidentialité</h3>\n\n        <p>\n          La matière opaque masque le contenu de votre envoi.\n        </p>\n\n      </article>\n\n\n\n      <article class=\"msp-benefit\">\n\n        <div class=\"msp-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <circle cx=\"12\" cy=\"13\" r=\"8\"/>\n            <path d=\"M12 9v4l3 2\"/>\n            <path d=\"M9 2h6M12 2v3\"/>\n          </svg>\n        </div>\n\n        <h3>Préparez plus rapidement</h3>\n\n        <p>\n          Emballez, fermez et passez immédiatement à l’étiquetage.\n        </p>\n\n      </article>\n\n\n\n      <article class=\"msp-benefit\">\n\n        <div class=\"msp-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M5 4h14v16H5V4Z\"/>\n            <path d=\"M8 8h8M8 12h8M8 16h5\"/>\n          </svg>\n        </div>\n\n        <h3>Un rendu professionnel</h3>\n\n        <p>\n          Présentez vos commandes dans un emballage sobre et propre.\n        </p>\n\n      </article>\n\n\n    </div>\n\n  </section>\n\n\n\n  <!-- =====================================================\n       3. S / M / L\n  ====================================================== -->\n\n  <section class=\"msp-section msp-soft\">\n\n    <div class=\"msp-heading\">\n\n      <span class=\"msp-kicker\">3 FORMATS</span>\n\n      <h2>Trois formats pour différents types d’envois</h2>\n\n      <p>\n        Choisissez la taille de pochette en fonction du volume\n        de l’article à emballer.\n      </p>\n\n    </div>\n\n\n    <div class=\"msp-sizes\">\n\n\n      <article class=\"msp-size\">\n\n        <span class=\"msp-size__badge\">S</span>\n\n        <h3>Petits accessoires</h3>\n\n        {% if ms_size_s != blank %}\n          <strong>{{ ms_size_s }}</strong>\n        {% endif %}\n\n        <p>\n          Pour les petits vêtements, accessoires et articles peu volumineux.\n        </p>\n\n      </article>\n\n\n\n      <article class=\"msp-size msp-size--featured\">\n\n        <span class=\"msp-size__badge\">M</span>\n\n        <h3>Vêtements légers</h3>\n\n        {% if ms_size_m != blank %}\n          <strong>{{ ms_size_m }}</strong>\n        {% endif %}\n\n        <p>\n          Un format polyvalent pour de nombreuses commandes e-commerce.\n        </p>\n\n      </article>\n\n\n\n      <article class=\"msp-size\">\n\n        <span class=\"msp-size__badge\">L</span>\n\n        <h3>Articles plus volumineux</h3>\n\n        {% if ms_size_l != blank %}\n          <strong>{{ ms_size_l }}</strong>\n        {% endif %}\n\n        <p>\n          Pour les textiles et produits nécessitant davantage d’espace.\n        </p>\n\n      </article>\n\n\n    </div>\n\n  </section>\n\n\n\n  <!-- =====================================================\n       4. MARKETPLACES\n  ====================================================== -->\n\n  <section class=\"msp-section\">\n\n    <div class=\"msp-heading\">\n\n      <span class=\"msp-kicker\">E-COMMERCE & MARKETPLACES</span>\n\n      <h2>Idéales pour vos commandes e-commerce</h2>\n\n      <p>\n        Les <strong>pochettes d’expédition</strong> sont utilisées par les\n        vendeurs en ligne pour emballer et protéger des articles avant leur\n        remise au transporteur.\n      </p>\n\n    </div>\n\n\n    <div class=\"msp-platforms\">\n\n      <span>Vinted</span>\n      <span>Shopify</span>\n      <span>Amazon</span>\n      <span>eBay</span>\n      <span>Etsy</span>\n      <span>TikTok Shop</span>\n\n    </div>\n\n  </section>\n\n\n\n  <!-- =====================================================\n       5. TRANSPORTEURS\n  ====================================================== -->\n\n  <section class=\"msp-section msp-soft\">\n\n    <div class=\"msp-heading\">\n\n      <span class=\"msp-kicker\">PRÉPARATION DES ENVOIS</span>\n\n      <h2>Préparez vos colis pour les principaux transporteurs</h2>\n\n      <p>\n        Ces pochettes peuvent servir d’<strong>emballage d’expédition</strong>\n        pour vos commandes, à condition de respecter les exigences de\n        dimensions, de poids et d’emballage du service de transport choisi.\n      </p>\n\n    </div>\n\n\n    <div class=\"msp-carriers\">\n\n      <span>Mondial Relay</span>\n      <span>Colissimo</span>\n      <span>Chronopost</span>\n      <span>DHL</span>\n      <span>UPS</span>\n      <span>GLS</span>\n      <span>FedEx</span>\n\n    </div>\n\n\n    <div class=\"msp-notice\">\n\n      <b>i</b>\n\n      <p>\n        La pochette n’est pas liée à un transporteur spécifique.\n        Vérifiez toujours les conditions d’emballage du service utilisé,\n        en particulier pour les objets fragiles ou à angles saillants.\n      </p>\n\n    </div>\n\n  </section>\n\n\n\n  <!-- =====================================================\n       6. CARACTÉRISTIQUES\n  ====================================================== -->\n\n  <section class=\"msp-section\">\n\n    <div class=\"msp-heading\">\n\n      <span class=\"msp-kicker\">FICHE TECHNIQUE</span>\n\n      <h2>Caractéristiques des pochettes d’expédition grises</h2>\n\n    </div>\n\n\n    <div class=\"msp-specs\">\n\n      <div>\n        <span>Type</span>\n        <strong>Pochette d’expédition</strong>\n      </div>\n\n      <div>\n        <span>Couleur</span>\n        <strong>Gris</strong>\n      </div>\n\n      <div>\n        <span>Fermeture</span>\n        <strong>Auto-adhésive</strong>\n      </div>\n\n      <div>\n        <span>Opacité</span>\n        <strong>Opaque</strong>\n      </div>\n\n      <div>\n        <span>Protection</span>\n        <strong>Résistante à l’humidité</strong>\n      </div>\n\n      <div>\n        <span>Résistance</span>\n        <strong>Conçue pour résister aux déchirures</strong>\n      </div>\n\n      <div>\n        <span>Quantité</span>\n        <strong>30 pochettes</strong>\n      </div>\n\n      <div>\n        <span>Tailles</span>\n        <strong>S / M / L</strong>\n      </div>\n\n\n      {% if ms_size_s != blank or ms_size_m != blank or ms_size_l != blank %}\n        <div>\n          <span>Dimensions</span>\n          <strong>\n            {% if ms_size_s != blank %}S : {{ ms_size_s }}{% endif %}\n            {% if ms_size_m != blank %} · M : {{ ms_size_m }}{% endif %}\n            {% if ms_size_l != blank %} · L : {{ ms_size_l }}{% endif %}\n          </strong>\n        </div>\n      {% endif %}\n\n\n      <div>\n        <span>Usage</span>\n        <strong>Vêtements, accessoires, e-commerce, expédition</strong>\n      </div>\n\n\n      {% if ms_material != blank %}\n        <div>\n          <span>Matière</span>\n          <strong>{{ ms_material }}</strong>\n        </div>\n      {% endif %}\n\n    </div>\n\n  </section>\n\n\n\n  <!-- =====================================================\n       7. COMMENT UTILISER\n  ====================================================== -->\n\n  <section class=\"msp-section\">\n\n    <div class=\"msp-heading\">\n\n      <span class=\"msp-kicker\">4 ÉTAPES</span>\n\n      <h2>Comment préparer un colis avec une pochette d’expédition ?</h2>\n\n      <p>\n        Une méthode simple pour préparer vos commandes avant leur expédition.\n      </p>\n\n    </div>\n\n\n    <div class=\"msp-steps\">\n\n\n      <article>\n\n        <span class=\"msp-step-number\">1</span>\n\n        <div class=\"msp-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M5 5h14v14H5V5Z\"/>\n            <path d=\"M8 9h8M8 13h5\"/>\n          </svg>\n        </div>\n\n        <h3>Insérez votre article</h3>\n\n        <p>\n          Placez le produit ou vêtement à l’intérieur de la pochette adaptée.\n        </p>\n\n      </article>\n\n\n\n      <article>\n\n        <span class=\"msp-step-number\">2</span>\n\n        <div class=\"msp-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M4 8h16v10H4V8Z\"/>\n            <path d=\"M4 8h16\"/>\n            <path d=\"m8 5 8 3\"/>\n          </svg>\n        </div>\n\n        <h3>Retirez la protection</h3>\n\n        <p>\n          Enlevez la bande protégeant l’adhésif de fermeture.\n        </p>\n\n      </article>\n\n\n\n      <article>\n\n        <span class=\"msp-step-number\">3</span>\n\n        <div class=\"msp-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M4 7h16v12H4V7Z\"/>\n            <path d=\"m4 7 8 6 8-6\"/>\n          </svg>\n        </div>\n\n        <h3>Fermez la pochette</h3>\n\n        <p>\n          Rabattez la fermeture puis appliquez une pression régulière.\n        </p>\n\n      </article>\n\n\n\n      <article>\n\n        <span class=\"msp-step-number\">4</span>\n\n        <div class=\"msp-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M5 4h14v16H5V4Z\"/>\n            <path d=\"M8 8h8M8 12h5\"/>\n            <path d=\"m15 17 2 2 4-4\"/>\n          </svg>\n        </div>\n\n        <h3>Collez votre étiquette</h3>\n\n        <p>\n          Apposez votre bordereau d’expédition sur une surface plane et visible.\n        </p>\n\n      </article>\n\n\n    </div>\n\n  </section>\n\n\n\n  <!-- =====================================================\n       8. POCHETTE VS CARTON\n  ====================================================== -->\n\n  <section class=\"msp-section\">\n\n    <div class=\"msp-heading\">\n\n      <span class=\"msp-kicker\">QUEL EMBALLAGE CHOISIR ?</span>\n\n      <h2>Pochette d’expédition ou carton ?</h2>\n\n      <p>\n        Les deux solutions répondent à des usages différents.\n        La pochette est particulièrement pratique pour les articles souples\n        et non fragiles, tandis que le carton reste préférable pour les objets\n        nécessitant davantage de protection.\n      </p>\n\n    </div>\n\n\n    <div class=\"msp-comparison\">\n\n      <div class=\"msp-comparison__head\">\n        <div>Critère</div>\n        <div class=\"msp-comparison__winner\">Pochette d’expédition</div>\n        <div>Carton</div>\n      </div>\n\n      <div class=\"msp-comparison__row\">\n        <strong>Vêtements / textile</strong>\n        <span class=\"msp-good\">✓ Très pratique</span>\n        <span>Possible</span>\n      </div>\n\n      <div class=\"msp-comparison__row\">\n        <strong>Poids de l’emballage</strong>\n        <span class=\"msp-good\">Léger</span>\n        <span>Plus lourd</span>\n      </div>\n\n      <div class=\"msp-comparison__row\">\n        <strong>Fermeture</strong>\n        <span class=\"msp-good\">Auto-adhésive</span>\n        <span>Ruban souvent nécessaire</span>\n      </div>\n\n      <div class=\"msp-comparison__row\">\n        <strong>Stockage</strong>\n        <span class=\"msp-good\">Peu encombrant</span>\n        <span>Plus volumineux</span>\n      </div>\n\n      <div class=\"msp-comparison__row\">\n        <strong>Produits fragiles</strong>\n        <span>Protection limitée</span>\n        <span class=\"msp-good\">Généralement préférable</span>\n      </div>\n\n      <div class=\"msp-comparison__row\">\n        <strong>Préparation rapide</strong>\n        <span class=\"msp-good\">✓</span>\n        <span>Variable</span>\n      </div>\n\n    </div>\n\n  </section>\n\n\n\n  <!-- =====================================================\n       9. POURQUOI UTILISER\n  ====================================================== -->\n\n  <section class=\"msp-section msp-why\">\n\n    <div>\n\n      <span class=\"msp-kicker\">EMBALLAGE COLIS</span>\n\n      <h2>Pourquoi utiliser une pochette d’expédition pour vos commandes ?</h2>\n\n      <p class=\"msp-why__lead\">\n        Une pochette d’expédition permet d’emballer rapidement certains\n        articles non fragiles tout en conservant un colis léger,\n        compact et facile à étiqueter.\n      </p>\n\n      <p>\n        Pour un vendeur en ligne, ce type d’<strong>emballage colis</strong>\n        facilite la <strong>préparation de commande</strong>, protège\n        le contenu des regards grâce à son opacité et crée une surface\n        adaptée à la pose du bordereau avant\n        <strong>l’expédition e-commerce</strong>.\n      </p>\n\n    </div>\n\n\n    <div class=\"msp-why__grid\">\n\n      <div>\n        <strong>Protection des articles</strong>\n        <span>Une enveloppe extérieure souple pour les produits non fragiles.</span>\n      </div>\n\n      <div>\n        <strong>Confidentialité</strong>\n        <span>La matière opaque masque le contenu du colis.</span>\n      </div>\n\n      <div>\n        <strong>Préparation rapide</strong>\n        <span>Une fermeture auto-adhésive simple à utiliser.</span>\n      </div>\n\n      <div>\n        <strong>Expédition e-commerce</strong>\n        <span>Une solution adaptée aux workflows de commande en ligne.</span>\n      </div>\n\n    </div>\n\n  </section>\n\n\n\n  <!-- =====================================================\n       10. DEFINITION GEO\n  ====================================================== -->\n\n  <section class=\"msp-section msp-definition\">\n\n    <div class=\"msp-definition__icon\">\n\n      <svg viewBox=\"0 0 24 24\" fill=\"none\">\n        <path d=\"M4 7h16v12H4V7Z\"/>\n        <path d=\"m4 7 8 6 8-6\"/>\n      </svg>\n\n    </div>\n\n\n    <div>\n\n      <span class=\"msp-kicker\">DÉFINITION</span>\n\n      <h2>Qu’est-ce qu’une pochette d’expédition ?</h2>\n\n      <p class=\"msp-definition__answer\">\n        Une <strong>pochette d’expédition</strong> est un emballage souple\n        utilisé pour protéger et envoyer des articles tels que des vêtements,\n        accessoires et produits non fragiles. Généralement opaque et\n        auto-adhésive, elle permet de fermer rapidement une commande puis\n        d’y apposer une étiquette de transport avant expédition.\n      </p>\n\n    </div>\n\n  </section>\n\n\n\n  <!-- =====================================================\n       11. CONFIANCE\n  ====================================================== -->\n\n  <section class=\"msp-section\">\n\n    <div class=\"msp-heading msp-heading--center\">\n\n      <span class=\"msp-kicker\">METASHOPPER</span>\n\n      <h2>Une solution pensée pour les e-commerçants</h2>\n\n      <p>\n        Des fournitures et équipements destinés à simplifier\n        votre préparation de commandes.\n      </p>\n\n    </div>\n\n\n    <div class=\"msp-trust\">\n\n      <article>\n        <strong>Expédition rapide</strong>\n        <span>Préparation et suivi de vos commandes.</span>\n      </article>\n\n      <article>\n        <strong>Retours sous 30 jours</strong>\n        <span>Une procédure de retour prévue si nécessaire.</span>\n      </article>\n\n      <article>\n        <strong>Support réactif</strong>\n        <span>Une équipe disponible pour vous accompagner.</span>\n      </article>\n\n      <article>\n        <strong>Spécialiste e-commerce</strong>\n        <span>Des produits dédiés à vos expéditions.</span>\n      </article>\n\n    </div>\n\n  </section>\n\n\n\n  <!-- =====================================================\n       12. AVIS CLIENTS\n  ====================================================== -->\n\n  <section class=\"msp-section\" id=\"avis-clients\">\n\n    <div class=\"msp-heading\">\n\n      <span class=\"msp-kicker\">AVIS CLIENTS</span>\n\n      <h2>Les avis sur nos pochettes d’expédition</h2>\n\n      <p>\n        Retrouvez ici les retours authentiques de clients ayant utilisé\n        ces pochettes pour leurs expéditions.\n      </p>\n\n    </div>\n\n    {% comment %}\n      INSÉRER ICI LE WIDGET RÉEL DE VOTRE APPLICATION D’AVIS.\n\n      Avis particulièrement utiles :\n      - résistance\n      - fermeture\n      - opacité\n      - tailles\n      - Vinted / e-commerce\n\n      Ne jamais recopier les avis de l’imprimante.\n    {% endcomment %}\n\n  </section>\n\n\n\n  <!-- =====================================================\n       13. FAQ\n  ====================================================== -->\n\n  <section class=\"msp-section\">\n\n    <div class=\"msp-heading\">\n\n      <span class=\"msp-kicker\">QUESTIONS FRÉQUENTES</span>\n\n      <h2>Questions fréquentes sur les pochettes d’expédition</h2>\n\n    </div>\n\n\n    <div class=\"msp-faq\">\n\n\n      <details>\n        <summary>\n          Combien de pochettes contient le pack ?\n          <span>+</span>\n        </summary>\n        <div>\n          Le pack contient <strong>30 pochettes d’expédition grises</strong>.\n        </div>\n      </details>\n\n\n      <details>\n        <summary>\n          Quelles sont les dimensions S, M et L ?\n          <span>+</span>\n        </summary>\n        <div>\n          Les dimensions exactes doivent être vérifiées dans les\n          caractéristiques du produit avant publication.\n        </div>\n      </details>\n\n\n      <details>\n        <summary>\n          Les pochettes sont-elles opaques ?\n          <span>+</span>\n        </summary>\n        <div>\n          Oui. Leur matière grise opaque permet de masquer le contenu\n          de votre commande pendant son acheminement.\n        </div>\n      </details>\n\n\n      <details>\n        <summary>\n          Sont-elles auto-adhésives ?\n          <span>+</span>\n        </summary>\n        <div>\n          Oui. Une bande adhésive intégrée permet de fermer la pochette\n          après avoir retiré sa protection.\n        </div>\n      </details>\n\n\n      <details>\n        <summary>\n          Faut-il ajouter du ruban adhésif ?\n          <span>+</span>\n        </summary>\n        <div>\n          Pour une utilisation normale, la fermeture auto-adhésive permet\n          de fermer la pochette sans ruban supplémentaire.\n        </div>\n      </details>\n\n\n      <details>\n        <summary>\n          Résistent-elles à l’humidité ?\n          <span>+</span>\n        </summary>\n        <div>\n          Elles sont conçues pour être\n          <strong>résistantes à l’humidité</strong> et aider à protéger\n          leur contenu pendant le transport.\n        </div>\n      </details>\n\n\n      <details>\n        <summary>\n          Peut-on les utiliser pour Vinted ?\n          <span>+</span>\n        </summary>\n        <div>\n          Oui, elles peuvent servir à emballer des articles adaptés à ce\n          type d’enveloppe avant une expédition liée à une vente Vinted.\n        </div>\n      </details>\n\n\n      <details>\n        <summary>\n          Peut-on coller une étiquette thermique 100×150 mm dessus ?\n          <span>+</span>\n        </summary>\n        <div>\n          Oui. Une étiquette d’expédition 100×150 mm peut être apposée\n          sur une zone propre, plane et suffisamment grande de la pochette.\n        </div>\n      </details>\n\n\n      <details>\n        <summary>\n          Quels produits peut-on expédier dans une pochette ?\n          <span>+</span>\n        </summary>\n        <div>\n          Elles conviennent particulièrement aux vêtements, textiles,\n          accessoires et autres produits non fragiles adaptés à un\n          emballage souple.\n        </div>\n      </details>\n\n\n      <details>\n        <summary>\n          Pochette ou carton : lequel choisir ?\n          <span>+</span>\n        </summary>\n        <div>\n          Une pochette est particulièrement pratique pour les articles\n          souples et non fragiles. Pour un produit fragile, rigide ou\n          nécessitant une protection contre les chocs, un carton avec un\n          calage adapté est généralement préférable.\n        </div>\n      </details>\n\n\n    </div>\n\n  </section>\n\n\n\n  <!-- =====================================================\n       14. CROSS SELL\n  ====================================================== -->\n\n  <section class=\"msp-crosssell\">\n\n    <div class=\"msp-crosssell__content\">\n\n      <span class=\"msp-crosssell__kicker\">\n        PRÉPARATION DE COMMANDES\n      </span>\n\n      <h2>Complétez votre préparation de commandes</h2>\n\n      <p>\n        Associez vos pochettes aux outils essentiels pour peser,\n        imprimer et étiqueter vos commandes depuis votre poste d’expédition.\n      </p>\n\n\n      <div class=\"msp-workflow\">\n\n        <span><b>1</b>Pochette</span>\n        <i>→</i>\n        <span><b>2</b>Balance</span>\n        <i>→</i>\n        <span><b>3</b>Imprimante</span>\n        <i>→</i>\n        <span><b>4</b>Étiquette</span>\n\n      </div>\n\n\n      <a\n        href=\"/products/metashopper-etiquettes-thermiques-100x150\"\n        class=\"msp-cta\"\n      >\n        Découvrir les étiquettes thermiques 4×6\n        <span>→</span>\n      </a>\n\n    </div>\n\n\n    {% if ms_labels.featured_image %}\n\n      <div class=\"msp-crosssell__image\">\n\n        {{\n          ms_labels.featured_image\n          | image_url: width: 900\n          | image_tag:\n            loading: 'lazy',\n            widths: '400, 600, 900',\n            alt: 'Étiquettes thermiques 100x150 mm Metashopper'\n        }}\n\n      </div>\n\n    {% endif %}\n\n  </section>\n\n\n\n  <!-- =====================================================\n       15. PRODUITS COMPLÉMENTAIRES\n  ====================================================== -->\n\n  <section class=\"msp-section\">\n\n    <div class=\"msp-heading msp-heading--center\">\n\n      <span class=\"msp-kicker\">COMPLÉTEZ VOTRE ÉQUIPEMENT</span>\n\n      <h2>Les indispensables pour vos expéditions</h2>\n\n    </div>\n\n\n    <div class=\"msp-products\">\n\n\n      {% if ms_labels != blank %}\n        <a href=\"{{ ms_labels.url }}\" class=\"msp-product\">\n\n          <div class=\"msp-product__image\">\n            {{\n              ms_labels.featured_image\n              | image_url: width: 600\n              | image_tag:\n                loading: 'lazy',\n                alt: ms_labels.title\n            }}\n          </div>\n\n          <div class=\"msp-product__content\">\n            <span>ÉTIQUETAGE</span>\n            <strong>{{ ms_labels.title }}</strong>\n            <small>À partir de {{ ms_labels.price | money }}</small>\n            <b>Découvrir →</b>\n          </div>\n\n        </a>\n      {% endif %}\n\n\n\n      {% if ms_printer != blank %}\n        <a href=\"{{ ms_printer.url }}\" class=\"msp-product\">\n\n          <div class=\"msp-product__image\">\n            {{\n              ms_printer.featured_image\n              | image_url: width: 600\n              | image_tag:\n                loading: 'lazy',\n                alt: ms_printer.title\n            }}\n          </div>\n\n          <div class=\"msp-product__content\">\n            <span>IMPRESSION</span>\n            <strong>{{ ms_printer.title }}</strong>\n            <small>À partir de {{ ms_printer.price | money }}</small>\n            <b>Découvrir →</b>\n          </div>\n\n        </a>\n      {% endif %}\n\n\n\n      {% if ms_scale != blank %}\n        <a href=\"{{ ms_scale.url }}\" class=\"msp-product\">\n\n          <div class=\"msp-product__image\">\n            {{\n              ms_scale.featured_image\n              | image_url: width: 600\n              | image_tag:\n                loading: 'lazy',\n                alt: ms_scale.title\n            }}\n          </div>\n\n          <div class=\"msp-product__content\">\n            <span>PESÉE</span>\n            <strong>{{ ms_scale.title }}</strong>\n            <small>{{ ms_scale.price | money }}</small>\n            <b>Découvrir →</b>\n          </div>\n\n        </a>\n      {% endif %}\n\n\n\n      {% if ms_support != blank %}\n        <a href=\"{{ ms_support.url }}\" class=\"msp-product\">\n\n          <div class=\"msp-product__image\">\n            {{\n              ms_support.featured_image\n              | image_url: width: 600\n              | image_tag:\n                loading: 'lazy',\n                alt: ms_support.title\n            }}\n          </div>\n\n          <div class=\"msp-product__content\">\n            <span>ACCESSOIRE</span>\n            <strong>{{ ms_support.title }}</strong>\n            <small>{{ ms_support.price | money }}</small>\n            <b>Découvrir →</b>\n          </div>\n\n        </a>\n      {% endif %}\n\n\n    </div>\n\n  </section>\n\n\n</div>\n\n\n<style>\n\n/* ==========================================================\n   METASHOPPER DESIGN SYSTEM\n========================================================== */\n\n.ms-pouch-page,\n.ms-pouch-page * {\n  box-sizing: border-box;\n}\n\n.ms-pouch-page {\n  --orange: #ff4713;\n  --black: #111111;\n  --text: #303030;\n  --muted: #6b6b6b;\n  --soft: #f7f7f9;\n  --border: #e8e8e8;\n  --white: #ffffff;\n\n  width: 100%;\n}\n\n.msp-section {\n  margin: 60px 0;\n}\n\n.msp-soft {\n  padding: 42px;\n  background: var(--soft);\n}\n\n.msp-heading {\n  max-width: 850px;\n  margin-bottom: 28px;\n}\n\n.msp-heading--center {\n  margin-left: auto;\n  margin-right: auto;\n  text-align: center;\n}\n\n.msp-kicker {\n  display: inline-block;\n  margin-bottom: 10px;\n\n  color: var(--orange);\n\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: .12em;\n}\n\n.ms-pouch-page h2 {\n  margin: 0 0 15px;\n\n  color: var(--black);\n\n  font-size: clamp(28px, 3vw, 42px);\n  line-height: 1.06;\n  letter-spacing: -.035em;\n}\n\n.msp-heading p,\n.msp-hero p {\n  color: var(--text);\n\n  font-size: 15px;\n  line-height: 1.7;\n}\n\n\n/* HERO */\n\n.msp-hero {\n  display: grid;\n\n  grid-template-columns: 1fr 1fr;\n\n  gap: 36px;\n\n  align-items: center;\n\n  margin: 55px 0;\n}\n\n.msp-hero__media {\n  aspect-ratio: 1 / 1;\n\n  overflow: hidden;\n\n  background: var(--soft);\n\n  border: 1px solid var(--border);\n}\n\n.msp-hero__media img {\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n}\n\n.msp-hero__lead {\n  color: var(--black) !important;\n\n  font-size: 17px !important;\n  font-weight: 600;\n}\n\n.msp-checks {\n  display: grid;\n\n  gap: 9px;\n\n  margin-top: 20px;\n}\n\n.msp-checks > div {\n  display: flex;\n\n  gap: 9px;\n\n  align-items: flex-start;\n\n  padding: 11px 13px;\n\n  background: var(--soft);\n\n  border: 1px solid var(--border);\n}\n\n.msp-checks span {\n  width: 21px;\n  height: 21px;\n\n  flex: 0 0 21px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  border-radius: 50%;\n\n  background: var(--orange);\n  color: #fff;\n\n  font-size: 11px;\n  font-weight: 800;\n}\n\n.msp-checks small {\n  color: var(--text);\n\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n\n/* ICON */\n\n.msp-icon {\n  width: 37px;\n  height: 37px;\n\n  margin-bottom: 18px;\n\n  color: var(--orange);\n}\n\n.msp-icon svg {\n  width: 100%;\n  height: 100%;\n\n  stroke: currentColor;\n\n  stroke-width: 1.6;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n\n/* BENEFITS */\n\n.msp-benefits {\n  display: grid;\n\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n\n  gap: 12px;\n}\n\n.msp-benefit {\n  min-height: 220px;\n\n  padding: 23px 19px;\n\n  background: var(--soft);\n\n  border: 1px solid var(--border);\n}\n\n.msp-benefit h3 {\n  margin: 0 0 8px;\n\n  color: var(--black);\n\n  font-size: 15px;\n}\n\n.msp-benefit p {\n  margin: 0;\n\n  color: var(--muted);\n\n  font-size: 12px;\n  line-height: 1.55;\n}\n\n\n/* SIZES */\n\n.msp-sizes {\n  display: grid;\n\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n\n  gap: 12px;\n}\n\n.msp-size {\n  position: relative;\n\n  padding: 27px 21px;\n\n  background: #fff;\n\n  border: 1px solid var(--border);\n}\n\n.msp-size--featured {\n  border: 2px solid var(--orange);\n}\n\n.msp-size__badge {\n  width: 42px;\n  height: 42px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  margin-bottom: 18px;\n\n  background: var(--black);\n  color: #fff;\n\n  border-radius: 50%;\n\n  font-size: 15px;\n  font-weight: 800;\n}\n\n.msp-size--featured .msp-size__badge {\n  background: var(--orange);\n}\n\n.msp-size h3 {\n  margin: 0 0 7px;\n\n  color: var(--black);\n\n  font-size: 16px;\n}\n\n.msp-size strong {\n  display: block;\n\n  margin-bottom: 8px;\n\n  color: var(--orange);\n\n  font-size: 13px;\n}\n\n.msp-size p {\n  margin: 0;\n\n  color: var(--muted);\n\n  font-size: 12px;\n  line-height: 1.55;\n}\n\n\n/* PLATFORMS */\n\n.msp-platforms {\n  display: grid;\n\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n\n  gap: 9px;\n}\n\n.msp-platforms span {\n  padding: 16px 14px;\n\n  text-align: center;\n\n  background: var(--soft);\n\n  border: 1px solid var(--border);\n\n  color: var(--black);\n\n  font-size: 13px;\n  font-weight: 750;\n}\n\n\n/* CARRIERS */\n\n.msp-carriers {\n  display: flex;\n\n  flex-wrap: wrap;\n\n  gap: 8px;\n}\n\n.msp-carriers span {\n  padding: 10px 14px;\n\n  background: #fff;\n\n  border: 1px solid var(--border);\n\n  color: var(--black);\n\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.msp-notice {\n  display: flex;\n\n  gap: 11px;\n\n  align-items: flex-start;\n\n  margin-top: 20px;\n\n  padding: 14px 16px;\n\n  background: #fff6f2;\n\n  border-left: 3px solid var(--orange);\n}\n\n.msp-notice b {\n  width: 22px;\n  height: 22px;\n\n  flex: 0 0 22px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  border-radius: 50%;\n\n  background: var(--orange);\n  color: #fff;\n\n  font-size: 12px;\n}\n\n.msp-notice p {\n  margin: 0;\n\n  color: var(--text);\n\n  font-size: 12px;\n  line-height: 1.55;\n}\n\n\n/* SPECS */\n\n.msp-specs {\n  overflow: hidden;\n\n  border: 1px solid var(--border);\n}\n\n.msp-specs > div {\n  display: grid;\n\n  grid-template-columns: .8fr 1.2fr;\n\n  border-bottom: 1px solid var(--border);\n}\n\n.msp-specs > div:last-child {\n  border-bottom: 0;\n}\n\n.msp-specs > div:nth-child(even) {\n  background: var(--soft);\n}\n\n.msp-specs span,\n.msp-specs strong {\n  padding: 15px 18px;\n\n  font-size: 13px;\n}\n\n.msp-specs span {\n  color: var(--muted);\n}\n\n.msp-specs strong {\n  color: var(--black);\n}\n\n\n/* STEPS */\n\n.msp-steps {\n  display: grid;\n\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n\n  gap: 12px;\n}\n\n.msp-steps article {\n  position: relative;\n\n  min-height: 225px;\n\n  padding: 23px 18px;\n\n  background: var(--soft);\n\n  border: 1px solid var(--border);\n}\n\n.msp-step-number {\n  position: absolute;\n\n  right: 13px;\n  top: 10px;\n\n  color: #d1d1d1;\n\n  font-size: 32px;\n  font-weight: 800;\n}\n\n.msp-steps h3 {\n  margin: 0 0 8px;\n\n  color: var(--black);\n\n  font-size: 15px;\n}\n\n.msp-steps p {\n  margin: 0;\n\n  color: var(--muted);\n\n  font-size: 11.5px;\n  line-height: 1.55;\n}\n\n\n/* COMPARISON */\n\n.msp-comparison {\n  overflow: hidden;\n\n  border: 1px solid var(--border);\n}\n\n.msp-comparison__head,\n.msp-comparison__row {\n  display: grid;\n\n  grid-template-columns: .9fr 1.1fr 1.1fr;\n}\n\n.msp-comparison__head {\n  background: var(--black);\n  color: #fff;\n}\n\n.msp-comparison__head > div,\n.msp-comparison__row > * {\n  padding: 15px 17px;\n}\n\n.msp-comparison__head > div {\n  font-size: 12.5px;\n  font-weight: 750;\n}\n\n.msp-comparison__winner {\n  background: var(--orange);\n}\n\n.msp-comparison__row {\n  border-bottom: 1px solid var(--border);\n}\n\n.msp-comparison__row:last-child {\n  border-bottom: 0;\n}\n\n.msp-comparison__row:nth-child(odd) {\n  background: var(--soft);\n}\n\n.msp-comparison__row > * {\n  font-size: 12px;\n}\n\n.msp-good {\n  color: var(--black);\n\n  font-weight: 750;\n}\n\n\n/* WHY */\n\n.msp-why {\n  display: grid;\n\n  grid-template-columns: 1.05fr .95fr;\n\n  gap: 40px;\n\n  padding: 42px;\n\n  background: #fff6f2;\n\n  border-left: 4px solid var(--orange);\n}\n\n.msp-why p {\n  color: var(--text);\n\n  font-size: 14px;\n  line-height: 1.7;\n}\n\n.msp-why__lead {\n  font-size: 16px !important;\n  font-weight: 600;\n}\n\n.msp-why__grid {\n  display: grid;\n\n  gap: 8px;\n}\n\n.msp-why__grid > div {\n  padding: 13px;\n\n  background: #fff;\n\n  border: 1px solid var(--border);\n}\n\n.msp-why__grid strong,\n.msp-why__grid span {\n  display: block;\n}\n\n.msp-why__grid strong {\n  margin-bottom: 4px;\n\n  color: var(--black);\n\n  font-size: 12.5px;\n}\n\n.msp-why__grid span {\n  color: var(--muted);\n\n  font-size: 10.5px;\n  line-height: 1.4;\n}\n\n\n/* GEO */\n\n.msp-definition {\n  display: grid;\n\n  grid-template-columns: 80px 1fr;\n\n  gap: 25px;\n\n  padding: 38px;\n\n  background: var(--soft);\n}\n\n.msp-definition__icon {\n  width: 60px;\n  height: 60px;\n\n  color: var(--orange);\n}\n\n.msp-definition__icon svg {\n  width: 100%;\n  height: 100%;\n\n  stroke: currentColor;\n\n  stroke-width: 1.5;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.msp-definition__answer {\n  max-width: 900px;\n\n  color: var(--text);\n\n  font-size: 16px;\n  line-height: 1.7;\n}\n\n\n/* TRUST */\n\n.msp-trust {\n  display: grid;\n\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n\n  gap: 10px;\n}\n\n.msp-trust article {\n  padding: 20px 16px;\n\n  background: var(--soft);\n\n  border: 1px solid var(--border);\n}\n\n.msp-trust strong,\n.msp-trust span {\n  display: block;\n}\n\n.msp-trust strong {\n  margin-bottom: 5px;\n\n  color: var(--black);\n\n  font-size: 13.5px;\n}\n\n.msp-trust span {\n  color: var(--muted);\n\n  font-size: 10.5px;\n  line-height: 1.45;\n}\n\n\n/* FAQ */\n\n.msp-faq {\n  border-top: 1px solid var(--border);\n}\n\n.msp-faq details {\n  border-bottom: 1px solid var(--border);\n}\n\n.msp-faq summary {\n  display: flex;\n\n  justify-content: space-between;\n  align-items: center;\n\n  gap: 20px;\n\n  padding: 18px 3px;\n\n  cursor: pointer;\n\n  list-style: none;\n\n  color: var(--black);\n\n  font-size: 13.5px;\n  font-weight: 700;\n}\n\n.msp-faq summary::-webkit-details-marker {\n  display: none;\n}\n\n.msp-faq summary span {\n  color: var(--orange);\n\n  font-size: 22px;\n\n  transition: transform .2s ease;\n}\n\n.msp-faq details[open] summary span {\n  transform: rotate(45deg);\n}\n\n.msp-faq details > div {\n  max-width: 850px;\n\n  padding: 0 35px 18px 3px;\n\n  color: var(--muted);\n\n  font-size: 12px;\n  line-height: 1.65;\n}\n\n\n/* CROSS SELL */\n\n.msp-crosssell {\n  display: grid;\n\n  grid-template-columns: 1.15fr .85fr;\n\n  overflow: hidden;\n\n  margin: 65px 0;\n\n  background: var(--black);\n}\n\n.msp-crosssell__content {\n  padding: 45px;\n}\n\n.msp-crosssell__kicker {\n  color: var(--orange);\n\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: .12em;\n}\n\n.msp-crosssell h2 {\n  margin-top: 11px;\n\n  color: #fff;\n}\n\n.msp-crosssell p {\n  max-width: 600px;\n\n  color: #c8c8c8;\n\n  font-size: 13px;\n  line-height: 1.65;\n}\n\n.msp-workflow {\n  display: flex;\n\n  flex-wrap: wrap;\n\n  align-items: center;\n\n  gap: 8px;\n\n  margin: 23px 0;\n}\n\n.msp-workflow span {\n  display: flex;\n\n  align-items: center;\n\n  gap: 5px;\n\n  color: #fff;\n\n  font-size: 10.5px;\n}\n\n.msp-workflow span b {\n  width: 21px;\n  height: 21px;\n\n  display: inline-flex;\n\n  justify-content: center;\n  align-items: center;\n\n  border-radius: 50%;\n\n  background: var(--orange);\n}\n\n.msp-workflow i {\n  color: #777;\n\n  font-style: normal;\n}\n\n.msp-cta {\n  display: inline-flex;\n\n  align-items: center;\n\n  gap: 9px;\n\n  padding: 14px 18px;\n\n  background: var(--orange);\n\n  color: #fff;\n\n  text-decoration: none;\n\n  font-size: 12.5px;\n  font-weight: 750;\n}\n\n.msp-crosssell__image {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  background: #fff;\n}\n\n.msp-crosssell__image img {\n  width: 100%;\n  height: 100%;\n\n  max-height: 420px;\n\n  object-fit: contain;\n}\n\n\n/* PRODUCTS */\n\n.msp-products {\n  display: grid;\n\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n\n  gap: 11px;\n}\n\n.msp-product {\n  overflow: hidden;\n\n  border: 1px solid var(--border);\n\n  color: inherit;\n\n  text-decoration: none;\n\n  background: #fff;\n\n  transition:\n    transform .2s ease,\n    box-shadow .2s ease;\n}\n\n.msp-product:hover {\n  transform: translateY(-3px);\n\n  box-shadow: 0 12px 28px rgba(0,0,0,.08);\n}\n\n.msp-product__image {\n  aspect-ratio: 1 / 1;\n\n  overflow: hidden;\n\n  background: var(--soft);\n}\n\n.msp-product__image img {\n  width: 100%;\n  height: 100%;\n\n  object-fit: contain;\n}\n\n.msp-product__content {\n  padding: 15px;\n}\n\n.msp-product__content > span {\n  display: block;\n\n  margin-bottom: 6px;\n\n  color: var(--orange);\n\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: .09em;\n}\n\n.msp-product__content strong {\n  display: block;\n\n  min-height: 44px;\n\n  color: var(--black);\n\n  font-size: 12px;\n  line-height: 1.35;\n}\n\n.msp-product__content small {\n  display: block;\n\n  margin-top: 8px;\n\n  color: var(--black);\n\n  font-size: 12.5px;\n  font-weight: 800;\n}\n\n.msp-product__content b {\n  display: block;\n\n  margin-top: 10px;\n\n  color: var(--orange);\n\n  font-size: 10.5px;\n}\n\n\n/* TABLETTE */\n\n@media screen and (max-width: 989px) {\n\n  .msp-hero {\n    grid-template-columns: 1fr;\n  }\n\n  .msp-benefits,\n  .msp-steps,\n  .msp-trust,\n  .msp-products {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .msp-platforms {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .msp-why {\n    grid-template-columns: 1fr;\n  }\n\n  .msp-crosssell {\n    grid-template-columns: 1fr;\n  }\n\n}\n\n\n/* MOBILE */\n\n@media screen and (max-width: 749px) {\n\n  .msp-section {\n    margin: 38px 0;\n  }\n\n  .msp-soft {\n    padding: 22px 15px;\n  }\n\n  .ms-pouch-page h2 {\n    font-size: 27px;\n    line-height: 1.08;\n  }\n\n  .msp-heading p,\n  .msp-hero p {\n    font-size: 12.5px;\n  }\n\n  .msp-hero {\n    gap: 18px;\n\n    margin: 35px 0;\n  }\n\n  .msp-hero__lead {\n    font-size: 14px !important;\n  }\n\n  .msp-benefits {\n    gap: 7px;\n  }\n\n  .msp-benefit {\n    min-height: 175px;\n\n    padding: 15px 11px;\n  }\n\n  .msp-icon {\n    width: 29px;\n    height: 29px;\n\n    margin-bottom: 12px;\n  }\n\n  .msp-benefit h3 {\n    font-size: 12px;\n  }\n\n  .msp-benefit p {\n    font-size: 10px;\n  }\n\n  .msp-sizes {\n    grid-template-columns: 1fr;\n\n    gap: 8px;\n  }\n\n  .msp-platforms {\n    gap: 6px;\n  }\n\n  .msp-platforms span {\n    padding: 12px 8px;\n\n    font-size: 11px;\n  }\n\n  .msp-carriers span {\n    padding: 8px 9px;\n\n    font-size: 10.5px;\n  }\n\n  .msp-specs > div {\n    grid-template-columns: .85fr 1.15fr;\n  }\n\n  .msp-specs span,\n  .msp-specs strong {\n    padding: 11px 8px;\n\n    font-size: 10.5px;\n  }\n\n  .msp-steps {\n    gap: 7px;\n  }\n\n  .msp-steps article {\n    min-height: 190px;\n\n    padding: 15px 10px;\n  }\n\n  .msp-steps h3 {\n    font-size: 12px;\n  }\n\n  .msp-steps p {\n    font-size: 10px;\n  }\n\n  .msp-comparison__head,\n  .msp-comparison__row {\n    grid-template-columns: .75fr 1fr 1fr;\n  }\n\n  .msp-comparison__head > div,\n  .msp-comparison__row > * {\n    padding: 9px 5px;\n\n    font-size: 9.3px;\n  }\n\n  .msp-why {\n    gap: 20px;\n\n    padding: 23px 16px;\n  }\n\n  .msp-why p {\n    font-size: 12px;\n  }\n\n  .msp-why__lead {\n    font-size: 14px !important;\n  }\n\n  .msp-definition {\n    grid-template-columns: 1fr;\n\n    gap: 13px;\n\n    padding: 23px 16px;\n  }\n\n  .msp-definition__icon {\n    width: 43px;\n    height: 43px;\n  }\n\n  .msp-definition__answer {\n    font-size: 13.5px;\n  }\n\n  .msp-trust {\n    gap: 7px;\n  }\n\n  .msp-trust article {\n    padding: 14px 10px;\n  }\n\n  .msp-trust strong {\n    font-size: 11.5px;\n  }\n\n  .msp-trust span {\n    font-size: 9.5px;\n  }\n\n  .msp-faq summary {\n    font-size: 12px;\n  }\n\n  .msp-faq details > div {\n    font-size: 11px;\n  }\n\n  .msp-crosssell {\n    margin: 42px 0;\n  }\n\n  .msp-crosssell__content {\n    padding: 27px 18px;\n  }\n\n  .msp-crosssell p {\n    font-size: 11.5px;\n  }\n\n  .msp-cta {\n    width: 100%;\n\n    justify-content: center;\n\n    text-align: center;\n\n    font-size: 11.5px;\n  }\n\n  .msp-products {\n    gap: 7px;\n  }\n\n  .msp-product__content {\n    padding: 10px;\n  }\n\n  .msp-product__content strong {\n    min-height: 49px;\n\n    font-size: 10px;\n  }\n\n  .msp-product__content small {\n    font-size: 11px;\n  }\n\n}\n\n</style>",
