benefits__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M4 12c0 0 2-5 8-5s8 5 8 5-2 5-8 5-8-5-8-5Z\"/>\n          <circle cx=\"12\" cy=\"12\" r=\"2.5\"/>\n          <path d=\"M2 12h2M20 12h2\"/>\n        </svg>\n      </span>\n      <span class=\"ms-product-benefits__content\">\n        <strong>Déroulement fluide</strong>\n        <small>Système de rouleau qui accompagne le ruban sur le carton</small>\n      </span>\n    </div>\n\n    <div class=\"ms-product-benefits__item\">\n      <span class=\"ms-product-benefits__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3-3a1 1 0 0 0-1.4-1.4L19 6.2l-.9-.9a1 1 0 0 0-1.4 0l-2 1Z\"/>\n          <path d=\"M3 21l9-9M11 3 3 11l2 2 8-8-2-2Z\"/>\n          <path d=\"M5 13l6 6\"/>\n        </svg>\n      </span>\n      <span class=\"ms-product-benefits__content\">\n        <strong>Lame remplaçable</strong>\n        <small>Prolongez l'utilisation en remplaçant uniquement la partie coupe</small>\n      </span>\n    </div>\n\n    <div class=\"ms-product-benefits__item\">\n      <span class=\"ms-product-benefits__icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <rect x=\"2\" y=\"9\" width=\"20\" height=\"6\" rx=\"2\"/>\n          <path d=\"M6 9V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2\"/>\n          <path d=\"M6 15v2a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-2\"/>\n          <path d=\"M12 9v6\"/>\n        </svg>\n      </span>\n      <span class=\"ms-product-benefits__content\">\n        <strong>Universel</strong>\n        <small>Compatible avec tous les rubans adhésifs standard (largeur 48–75 mm)</small>\n      </span>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .ms-product-benefits {\n    --ms-benefit-background: #F7F7F9;\n    --ms-benefit-text: #1f1f1f;\n    --ms-benefit-icon: #ff4713;\n    --ms-benefit-radius: 2px;\n    --ms-benefit-gap: 12px;\n    --ms-benefit-icon-size: 32px;\n    --ms-benefit-title-size: 14px;\n    --ms-benefit-description-size: 12px;\n\n    width: 100%;\n    margin: 18px 0;\n  }\n\n  .ms-product-benefits,\n  .ms-product-benefits * {\n    box-sizing: border-box;\n  }\n\n  .ms-product-benefits__grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: var(--ms-benefit-gap);\n  }\n\n  .ms-product-benefits__item {\n    min-width: 0;\n    min-height: 72px;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 13px 15px;\n    background: var(--ms-benefit-background);\n    color: var(--ms-benefit-text);\n    border-radius: var(--ms-benefit-radius);\n  }\n\n  .ms-product-benefits__icon {\n    width: var(--ms-benefit-icon-size);\n    height: var(--ms-benefit-icon-size);\n    flex: 0 0 var(--ms-benefit-icon-size);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--ms-benefit-icon);\n  }\n\n  .ms-product-benefits__icon svg {\n    width: 100%;\n    height: 100%;\n    display: block;\n    stroke: currentColor;\n    stroke-width: 1.65;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .ms-product-benefits__content {\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 3px;\n    line-height: 1.25;\n  }\n\n  .ms-product-benefits__content strong {\n    display: block;\n    margin: 0;\n    color: var(--ms-benefit-text);\n    font-size: var(--ms-benefit-title-size);\n    font-weight: 650;\n  }\n\n  .ms-product-benefits__content small {\n    display: block;\n    margin: 0;\n    color: var(--ms-benefit-text);\n    font-size: var(--ms-benefit-description-size);\n    line-height: 1.3;\n    opacity: 0.72;\n  }\n\n  @media screen and (max-width: 989px) {\n    .ms-product-benefits__grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .ms-product-benefits {\n      --ms-benefit-gap: 8px;\n      --ms-benefit-icon-size: 29px;\n      --ms-benefit-title-size: 13px;\n      --ms-benefit-description-size: 11px;\n      margin: 14px 0;\n    }\n\n    .ms-product-benefits__grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      align-items: start;\n      gap: 6px;\n    }\n\n    .ms-product-benefits__item {\n      min-height: 0;\n      height: auto;\n      padding: 7px 7px;\n      gap: 6px;\n      align-items: flex-start;\n    }\n\n    .ms-product-benefits__icon {\n      width: 23px;\n      height: 23px;\n      flex-basis: 23px;\n    }\n\n    .ms-product-benefits__content {\n      gap: 1px;\n    }\n\n    .ms-product-benefits__content strong {\n      font-size: 11.5px;\n      line-height: 1.15;\n    }\n\n    .ms-product-benefits__content small {\n      font-size: 10.0px;\n      line-height: 1.18;\n    }\n  }\n</style>"
