shome-trust{\n  display:grid;grid-template-columns:repeat(4,1fr);\n  border:1px solid var(--bd);border-radius:7px;overflow:hidden\n}\n.mshome-trust>div{\n  min-height:82px;display:flex;align-items:center;gap:10px;padding:15px\n}\n.mshome-trust>div+div{border-left:1px solid var(--bd)}\n.mshome-trust b{color:var(--o);font-size:19px}\n.mshome-trust p{margin:0}\n.mshome-trust strong{display:block;font-size:11px;color:var(--b)}\n.mshome-trust small{display:block;margin-top:2px;font-size:8.5px;color:var(--m)}\n.mshome-three{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}\n.mshome-category,.mshome-product{\n  overflow:hidden;border:1px solid var(--bd);border-radius:8px;\n  background:#fff;color:var(--t)!important;text-decoration:none!important;\n  transition:.22s ease\n}\n.mshome-category:hover,.mshome-product:hover{\n  transform:translateY(-4px);box-shadow:0 15px 35px rgba(0,0,0,.07)\n}\n.mshome-category-img,.mshome-product-img{\n  aspect-ratio:1.3/1;background:#fafafa;overflow:hidden\n}\n.mshome-category-img img,.mshome-product-img img{\n  width:100%;height:100%;object-fit:contain;padding:15px\n}\n.mshome-category-copy,.mshome-product-copy{padding:22px}\n.mshome-category-copy>span,.mshome-product-copy>small{\n  color:var(--o);font-size:8px;font-weight:800;letter-spacing:.1em\n}\n.mshome-category-copy h3,.mshome-product-copy h3{\n  margin:7px 0;font-size:19px\n}\n.mshome-category-copy p,.mshome-product-copy p{\n  margin:0 0 15px;color:var(--m);font-size:11px;line-height:1.55\n}\n.mshome-category-copy strong,.mshome-product-copy b{font-size:10px;color:var(--b)}\n.mshome-dark,.mshome-video,.mshome-final{\n  padding:96px 0;background:var(--b);color:#fff\n}\n.mshome-split{\n  display:grid;grid-template-columns:.92fr 1.08fr;\n  gap:68px;align-items:center\n}\n.mshome-dark h2,.mshome-final h2{color:#fff}\n.mshome-dark-lead{color:rgba(255,255,255,.66);font-size:14px;line-height:1.7}\n.mshome-specs{\n  display:grid;grid-template-columns:repeat(2,1fr);\n  margin:27px 0;border-top:1px solid rgba(255,255,255,.15);\n  border-left:1px solid rgba(255,255,255,.15)\n}\n.mshome-specs div{\n  padding:17px;border-right:1px solid rgba(255,255,255,.15);\n  border-bottom:1px solid rgba(255,255,255,.15)\n}\n.mshome-specs strong{display:block;color:#fff;font-size:14px}\n.mshome-specs small{color:rgba(255,255,255,.5);font-size:8px}\n.mshome-dark-image{overflow:hidden;border-radius:9px;background:#fff}\n.mshome-dark-image img{display:block;width:100%;height:auto}\n.mshome-packs{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}\n.mshome-pack{\n  position:relative;padding:27px;border:1px solid var(--bd);\n  border-radius:8px;background:#fff\n}\n.mshome-pack-best{\n  border:2px solid var(--o);\n  box-shadow:0 18px 42px rgba(255,71,19,.1);\n  transform:translateY(-7px)\n}\n.mshome-popular{\n  position:absolute;top:-13px;left:50%;transform:translateX(-50%);\n  padding:6px 11px;border-radius:99px;background:var(--o);color:#fff;\n  font-size:7.5px;font-weight:800;white-space:nowrap\n}\n.mshome-pack-label{color:var(--o);font-size:8px;font-weight:800;letter-spacing:.1em}\n.mshome-pack h3{margin:7px 0;font-size:27px}\n.mshome-pack-price{margin:10px 0 17px;font-size:25px;font-weight:850;color:var(--b)}\n.mshome-pack ul{margin:0 0 22px;padding:0;list-style:none}\n.mshome-pack li{margin:9px 0;padding-left:18px;position:relative;font-size:11.5px}\n.mshome-pack li:before{content:\"✓\";position:absolute;left:0;color:var(--o);font-weight:800}\n.mshome-pack .mshome-btn{width:100%}\n.mshome-fineprint,.mshome-note,.mshome-review-note{\n  max-width:760px;margin:22px auto 0;text-align:center;color:var(--m);\n  font-size:9px;line-height:1.5\n}\n.mshome-heading-light h2{color:#fff}\n.mshome-heading-light p{color:rgba(255,255,255,.6)}\n.mshome-video-widget{max-width:1150px;margin:auto}\n.mshome-two{display:grid;grid-template-columns:repeat(2,1fr);gap:17px}\n.mshome-platform-card{\n  padding:32px;border:1px solid var(--bd);border-radius:8px;background:#fff\n}\n.mshome-platform-card small{\n  color:var(--o);font-size:8px;font-weight:800;letter-spacing:.1em\n}\n.mshome-platform-card h3{margin:8px 0 18px;font-size:21px}\n.mshome-chips{display:flex;flex-wrap:wrap;gap:7px}\n.mshome-chips span{\n  padding:7px 10px;border-radius:4px;background:var(--s);\n  font-size:10px;font-weight:700\n}\n.mshome-four{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}\n.mshome-four article{\n  min-height:170px;padding:22px;border:1px solid var(--bd);\n  border-radius:7px;background:#fff\n}\n.mshome-four article>span{color:var(--o);font-size:9px;font-weight:800}\n.mshome-four h3{margin:26px 0 7px;font-size:16px}\n.mshome-four p{margin:0;color:var(--m);font-size:10.5px;line-height:1.55}\n.mshome-comparison-layout{\n  display:grid;grid-template-columns:.8fr 1.2fr;gap:65px;align-items:center\n}\n.mshome-copy{color:var(--m);font-size:13px;line-height:1.7}\n.mshome-table{overflow:hidden;border:1px solid var(--bd);border-radius:7px}\n.mshome-table>div{display:grid;grid-template-columns:1.2fr .8fr 1fr}\n.mshome-table>div>*{\n  padding:15px;border-bottom:1px solid var(--bd);font-size:10px\n}\n.mshome-table>div>*+*{border-left:1px solid var(--bd)}\n.mshome-table-head{background:var(--b);color:#fff}\n.mshome-table-head>*{color:#fff!important;font-weight:800}\n.mshome-table strong{color:#18824a}\n.mshome-reviews{padding:96px 0;background:var(--s)}\n.mshome-review-score{margin-top:10px;color:var(--o);font-size:16px}\n.mshome-review-score strong{margin-left:7px;color:var(--b)}\n.mshome-review-track{\n  display:grid;grid-auto-flow:column;grid-auto-columns:minmax(280px,31%);\n  gap:14px;overflow-x:auto;padding:4px 2px 17px;\n  scroll-snap-type:x mandatory;scrollbar-width:thin\n}\n.mshome-review-track article{\n  min-height:225px;display:flex;flex-direction:column;padding:24px;\n  border:1px solid var(--bd);border-radius:7px;background:#fff;\n  scroll-snap-align:start\n}\n.mshome-stars{color:var(--o);font-size:11px;letter-spacing:.06em}\n.mshome-review-track h3{margin:18px 0 8px;font-size:16px}\n.mshome-review-track p{flex:1;margin:0;color:var(--m);font-size:11px;line-height:1.6}\n.mshome-review-track footer{margin-top:20px;padding-top:13px;border-top:1px solid var(--bd)}\n.mshome-review-track footer b{display:block;font-size:10px;color:var(--b)}\n.mshome-review-track footer small{font-size:8px;color:var(--m)}\n.mshome-answer{padding:90px 0;background:#fff3ee}\n.mshome-answer-grid article{\n  padding:25px;border:1px solid rgba(255,71,19,.13);\n  border-radius:7px;background:#fff\n}\n.mshome-answer-grid h3{margin:0 0 11px;font-size:16px;line-height:1.3}\n.mshome-answer-grid p{margin:0;color:var(--m);font-size:11px;line-height:1.65}\n.mshome-faq{max-width:900px;margin:auto;border-top:1px solid var(--bd)}\n.mshome-faq details{border-bottom:1px solid var(--bd)}\n.mshome-faq summary{\n  position:relative;padding:20px 40px 20px 0;cursor:pointer;\n  list-style:none;color:var(--b);font-size:12.5px;font-weight:750\n}\n.mshome-faq summary::-webkit-details-marker{display:none}\n.mshome-faq summary:after{\n  content:\"+\";position:absolute;right:3px;top:14px;color:var(--o);font-size:24px\n}\n.mshome-faq details[open] summary:after{content:\"−\"}\n.mshome-faq details p{\n  margin:0;padding:0 40px 20px 0;color:var(--m);font-size:11px;line-height:1.7\n}\n.mshome-final{text-align:center}\n.mshome-final h2{font-size:clamp(42px,6vw,72px)}\n.mshome-final>div>p{\n  max-width:600px;margin:0 auto;color:rgba(255,255,255,.62);\n  font-size:13px;line-height:1.7\n}\n.mshome-final-trust{\n  display:flex;justify-content:center;flex-wrap:wrap;gap:9px 20px;\n  margin-top:22px;color:rgba(255,255,255,.48);font-size:9px\n}\n\n@media(max-width:989px){\n  .mshome-hero-grid,.mshome-split,.mshome-comparison-layout{grid-template-columns:1fr}\n  .mshome-hero{background:#fff}\n  .mshome-three,.mshome-packs{grid-template-columns:1fr}\n  .mshome-pack-best{transform:none}\n  .mshome-trust{grid-template-columns:repeat(2,1fr)}\n  .mshome-trust>div:nth-child(3){border-left:0;border-top:1px solid var(--bd)}\n  .mshome-trust>div:nth-child(4){border-top:1px solid var(--bd)}\n  .mshome-four{grid-template-columns:repeat(2,1fr)}\n  .mshome-review-track{grid-auto-columns:minmax(280px,46%)}\n}\n\n@media(max-width:749px){\n  .mshome-wrap{width:calc(100% - 28px)}\n  .mshome-section,.mshome-dark,.mshome-video,.mshome-reviews,.mshome-answer,.mshome-final{\n    padding:59px 0\n  }\n  .mshome-hero{padding:44px 0 34px}\n  .mshome-hero-grid{gap:34px}\n  .mshome h1{font-size:clamp(37px,12vw,48px)}\n  .mshome h2{font-size:29px}\n  .mshome-lead{font-size:15px}\n  .mshome-actions{display:grid}\n  .mshome-actions .mshome-btn{width:100%}\n  .mshome-hero-media{min-height:320px;padding:25px 16px}\n  .mshome-trust>div{min-height:73px;padding:10px}\n  .mshome-trust strong{font-size:9.5px}\n  .mshome-trust small{font-size:7.5px}\n  .mshome-heading{margin-bottom:34px}\n  .mshome-heading p{font-size:11.5px}\n  .mshome-two,.mshome-four{grid-template-columns:1fr}\n  .mshome-platform-card{padding:22px 18px}\n  .mshome-four article{min-height:135px}\n  .mshome-table{overflow-x:auto}\n  .mshome-table>div{min-width:570px}\n  .mshome-review-track{grid-auto-columns:84%}\n}\n</style>",
