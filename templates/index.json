      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "{% comment %}\n=============================================================\nMETASHOPPER — HOMEPAGE PREMIUM\nVERSION SIMPLIFIÉE / ROBUSTE POUR LIQUID PERSONNALISÉ\nSEO + GEO + CONVERSION + MOBILE\n=============================================================\n{% endcomment %}\n\n{% assign x4 = all_products['metashopper-imprimante-thermique-bluetooth'] %}\n{% assign labels = all_products['metashopper-etiquettes-thermiques-100x150'] %}\n{% assign support = all_products['support-detiquettes-thermique'] %}\n{% assign balance = all_products['balance-colis-digitale'] %}\n\n<div class=\"mshome\">\n\n  <!-- =====================================================\n       HERO\n       ===================================================== -->\n\n  <section class=\"mshome-hero\">\n    <div class=\"mshome-wrap mshome-hero-grid\">\n\n      <div class=\"mshome-hero-copy\">\n\n        <div class=\"mshome-kicker\">\n          L'IMPRESSION THERMIQUE PENSÉE POUR LES E-COMMERÇANTS\n        </div>\n\n        <h1>\n          Imprimante thermique Bluetooth\n          <em>4×6 pour vos étiquettes colis</em>\n        </h1>\n\n        <p class=\"mshome-lead\">\n          Imprimez vos bordereaux d'expédition\n          <strong>100 × 150 mm</strong> sans cartouche ni toner,\n          depuis votre smartphone ou votre ordinateur.\n        </p>\n\n        <div class=\"mshome-rating\">\n          <span>★★★★★</span>\n          <strong>4,9/5 de moyenne</strong>\n          <small>Avis clients MetaShopper</small>\n        </div>\n\n        <div class=\"mshome-actions\">\n          <a href=\"/products/metashopper-imprimante-thermique-bluetooth\"\n             class=\"mshome-btn mshome-btn-orange\">\n            Découvrir la X4\n          </a>\n\n          <a href=\"#packs-metashopper\"\n             class=\"mshome-btn mshome-btn-white\">\n            Comparer les 3 packs\n          </a>\n        </div>\n\n        <div class=\"mshome-microtrust\">\n          <span>✓ Expédié depuis la France</span>\n          <span>✓ Garantie 2 ans</span>\n          <span>✓ Retours 30 jours</span>\n        </div>\n\n      </div>\n\n      <div class=\"mshome-hero-media\">\n\n        {% if x4.featured_image %}\n          {{\n            x4.featured_image\n            | image_url: width: 1200\n            | image_tag:\n              loading: 'eager',\n              fetchpriority: 'high',\n              widths: '500,700,900,1200',\n              sizes: '(min-width: 990px) 50vw, 100vw',\n              alt: 'Imprimante thermique Bluetooth MetaShopper X4 pour étiquettes colis 100 x 150 mm'\n          }}\n        {% endif %}\n\n        <div class=\"mshome-badge mshome-badge-a\">\n          <strong>4×6</strong>\n          <span>100 × 150 mm</span>\n        </div>\n\n        <div class=\"mshome-badge mshome-badge-b\">\n          <strong>Sans encre</strong>\n          <span>Thermique directe</span>\n        </div>\n\n      </div>\n\n    </div>\n  </section>\n\n\n  <!-- =====================================================\n       TRUST BAR\n       ===================================================== -->\n\n  <section class=\"mshome-trust-section\">\n    <div class=\"mshome-wrap\">\n\n      <div class=\"mshome-trust\">\n\n        <div>\n          <b>🚚</b>\n          <p>\n            <strong>Livraison rapide</strong>\n            <small>Expédition depuis la France</small>\n          </p>\n        </div>\n\n        <div>\n          <b>☆</b>\n          <p>\n            <strong>Garantie 2 ans</strong>\n            <small>Achetez sereinement</small>\n          </p>\n        </div>\n\n        <div>\n          <b>↩</b>\n          <p>\n            <strong>Retours 30 jours</strong>\n            <small>Selon nos conditions</small>\n          </p>\n        </div>\n\n        <div>\n          <b>🔒</b>\n          <p>\n            <strong>Paiement sécurisé</strong>\n            <small>Plusieurs moyens de paiement</small>\n          </p>\n        </div>\n\n      </div>\n\n    </div>\n  </section>\n\n\n  <!-- =====================================================\n       POSITIONNEMENT\n       ===================================================== -->\n\n  <section class=\"mshome-section\">\n\n    <div class=\"mshome-wrap\">\n\n      <div class=\"mshome-heading\">\n        <span>VOTRE POSTE D'EXPÉDITION</span>\n\n        <h2>\n          Tout ce qu'il faut pour préparer vos commandes\n        </h2>\n\n        <p>\n          Imprimez vos bordereaux, organisez vos étiquettes\n          et préparez vos colis avec des équipements dédiés\n          aux vendeurs en ligne.\n        </p>\n      </div>\n\n\n      <div class=\"mshome-three\">\n\n        <a href=\"/products/metashopper-imprimante-thermique-bluetooth\"\n           class=\"mshome-category\">\n\n          <div class=\"mshome-category-img\">\n\n            {% if x4.featured_image %}\n              {{\n                x4.featured_image\n                | image_url: width: 750\n                | image_tag:\n                  loading: 'lazy',\n                  widths: '350,550,750',\n                  alt: 'Imprimante thermique MetaShopper X4'\n              }}\n            {% endif %}\n\n          </div>\n\n          <div class=\"mshome-category-copy\">\n            <span>01 · IMPRIMER</span>\n            <h3>MetaShopper X4</h3>\n            <p>\n              Votre imprimante thermique Bluetooth\n              dédiée aux étiquettes colis.\n            </p>\n            <strong>Découvrir →</strong>\n          </div>\n\n        </a>\n\n\n        <a href=\"/products/metashopper-etiquettes-thermiques-100x150\"\n           class=\"mshome-category\">\n\n          <div class=\"mshome-category-img\">\n\n            {% if labels.featured_image %}\n              {{\n                labels.featured_image\n                | image_url: width: 750\n                | image_tag:\n                  loading: 'lazy',\n                  widths: '350,550,750',\n                  alt: 'Étiquettes thermiques MetaShopper 100 x 150 mm'\n              }}\n            {% endif %}\n\n          </div>\n\n          <div class=\"mshome-category-copy\">\n            <span>02 · ÉTIQUETER</span>\n            <h3>Étiquettes 100 × 150 mm</h3>\n            <p>\n              Format adhésif 4×6 pensé\n              pour vos bordereaux d'expédition.\n            </p>\n            <strong>Découvrir →</strong>\n          </div>\n\n        </a>\n\n\n        <a href=\"/collections/all\"\n           class=\"mshome-category\">\n\n          <div class=\"mshome-category-img\">\n\n            {% if balance.featured_image %}\n              {{\n                balance.featured_image\n                | image_url: width: 750\n                | image_tag:\n                  loading: 'lazy',\n                  widths: '350,550,750',\n                  alt: 'Équipements pour préparer les commandes MetaShopper'\n              }}\n            {% endif %}\n\n          </div>\n\n          <div class=\"mshome-category-copy\">\n            <span>03 · PRÉPARER</span>\n            <h3>Équipement d'expédition</h3>\n            <p>\n              Balance, support, emballages\n              et accessoires pour vos colis.\n            </p>\n            <strong>Voir les équipements →</strong>\n          </div>\n\n        </a>\n\n      </div>\n\n    </div>\n  </section>\n\n\n  <!-- =====================================================\n       X4 FEATURE\n       ===================================================== -->\n\n  <section class=\"mshome-dark\">\n\n    <div class=\"mshome-wrap mshome-split\">\n\n      <div>\n\n        <div class=\"mshome-kicker\">\n          NOTRE PRODUIT VEDETTE\n        </div>\n\n        <h2>\n          Une imprimante dédiée à vos expéditions\n        </h2>\n\n        <p class=\"mshome-dark-lead\">\n          La MetaShopper X4 utilise l'impression thermique directe :\n          aucune cartouche d'encre et aucun toner à remplacer.\n        </p>\n\n        <div class=\"mshome-specs\">\n          <div><strong>203 DPI</strong><small>Résolution</small></div>\n          <div><strong>150 mm/s</strong><small>Jusqu'à</small></div>\n          <div><strong>30–110 mm</strong><small>Largeur</small></div>\n          <div><strong>Bluetooth + USB</strong><small>Connexion</small></div>\n        </div>\n\n        <a href=\"/products/metashopper-imprimante-thermique-bluetooth\"\n           class=\"mshome-btn mshome-btn-orange\">\n          Voir la MetaShopper X4\n        </a>\n\n      </div>\n\n\n      <div class=\"mshome-dark-image\">\n\n        {% if x4.media.size > 1 %}\n          {% assign x4_second_image = x4.media[1].preview_image %}\n        {% else %}\n          {% assign x4_second_image = x4.featured_image %}\n        {% endif %}\n\n        {% if x4_second_image %}\n          {{\n            x4_second_image\n            | image_url: width: 1100\n            | image_tag:\n              loading: 'lazy',\n              widths: '500,750,1100',\n              alt: 'Imprimante thermique MetaShopper pour préparation de commandes'\n          }}\n        {% endif %}\n\n      </div>\n\n    </div>\n  </section>\n\n\n  <!-- =====================================================\n       PACKS\n       ===================================================== -->\n\n  <section id=\"packs-metashopper\"\n           class=\"mshome-section mshome-soft\">\n\n    <div class=\"mshome-wrap\">\n\n      <div class=\"mshome-heading\">\n        <span>3 PACKS DISPONIBLES</span>\n\n        <h2>\n          Choisissez selon votre volume d'expédition\n        </h2>\n\n        <p>\n          La même imprimante X4 avec une quantité\n          de consommables adaptée à votre activité.\n        </p>\n      </div>\n\n\n      <div class=\"mshome-packs\">\n\n        <article class=\"mshome-pack\">\n          <span class=\"mshome-pack-label\">POUR COMMENCER</span>\n\n          <h3>Starter</h3>\n\n          <div class=\"mshome-pack-price\">\n            69,90 €\n          </div>\n\n          <ul>\n            <li>Imprimante thermique X4</li>\n            <li>200 étiquettes 100 × 150 mm</li>\n            <li>Bluetooth + USB</li>\n          </ul>\n\n          <a href=\"/products/metashopper-imprimante-thermique-bluetooth\"\n             class=\"mshome-btn mshome-btn-white\">\n            Choisir Starter\n          </a>\n        </article>\n\n\n        <article class=\"mshome-pack mshome-pack-best\">\n\n          <div class=\"mshome-popular\">\n            LE PLUS ÉQUILIBRÉ\n          </div>\n\n          <span class=\"mshome-pack-label\">VENDEURS RÉGULIERS</span>\n\n          <h3>Business</h3>\n\n          <div class=\"mshome-pack-price\">\n            79,90 €\n          </div>\n\n          <ul>\n            <li>Imprimante thermique X4</li>\n            <li>500 étiquettes 100 × 150 mm</li>\n            <li>Support d'étiquettes</li>\n          </ul>\n\n          <a href=\"/products/metashopper-imprimante-thermique-bluetooth\"\n             class=\"mshome-btn mshome-btn-orange\">\n            Choisir Business\n          </a>\n        </article>\n\n\n        <article class=\"mshome-pack\">\n\n          <span class=\"mshome-pack-label\">VOLUMES IMPORTANTS</span>\n\n          <h3>Business Pro</h3>\n\n          <div class=\"mshome-pack-price\">\n            89,90 €\n          </div>\n\n          <ul>\n            <li>Imprimante thermique X4</li>\n            <li>1 000 étiquettes 100 × 150 mm</li>\n            <li>Support d'étiquettes</li>\n          </ul>\n\n          <a href=\"/products/metashopper-imprimante-thermique-bluetooth\"\n             class=\"mshome-btn mshome-btn-white\">\n            Choisir Business Pro\n          </a>\n        </article>\n\n      </div>\n\n      <p class=\"mshome-fineprint\">\n        Sélectionnez ensuite votre couleur et votre pack\n        directement sur la fiche de l'imprimante X4.\n      </p>\n\n    </div>\n  </section>\n\n\n  <!-- =====================================================\n       VIDEO\n       ===================================================== -->\n\n  <section class=\"mshome-video\">\n\n    <div class=\"mshome-wrap\">\n\n      <div class=\"mshome-heading mshome-heading-light\">\n        <span>VOYEZ-LA EN ACTION</span>\n\n        <h2>\n          Découvrez la X4 en situation réelle\n        </h2>\n\n        <p>\n          Regardez l'impression des étiquettes\n          et la préparation des colis.\n        </p>\n      </div>\n\n      <div class=\"mshome-video-widget\">\n\n        <div id=\"ss-product-videos\"></div>\n\n      </div>\n\n    </div>\n  </section>\n\n\n  <!-- =====================================================\n       COMPATIBILITES\n       ===================================================== -->\n\n  <section class=\"mshome-section\">\n\n    <div class=\"mshome-wrap\">\n\n      <div class=\"mshome-heading\">\n        <span>VOTRE WORKFLOW E-COMMERCE</span>\n\n        <h2>\n          De votre vente au colis prêt à partir\n        </h2>\n\n        <p>\n          Téléchargez votre bordereau depuis votre plateforme\n          ou votre transporteur puis imprimez-le\n          lorsqu'il est disponible dans un format adapté.\n        </p>\n      </div>\n\n\n      <div class=\"mshome-two\">\n\n        <article class=\"mshome-platform-card\">\n          <small>MARKETPLACES &amp; BOUTIQUES</small>\n          <h3>Vendez où sont vos clients</h3>\n\n          <div class=\"mshome-chips\">\n            <span>Vinted</span>\n            <span>Shopify</span>\n            <span>Amazon</span>\n            <span>eBay</span>\n            <span>Etsy</span>\n            <span>TikTok Shop</span>\n          </div>\n        </article>\n\n\n        <article class=\"mshome-platform-card\">\n          <small>EXPÉDITION</small>\n          <h3>Préparez vos bordereaux colis</h3>\n\n          <div class=\"mshome-chips\">\n            <span>Colissimo</span>\n            <span>Mondial Relay</span>\n            <span>Chronopost</span>\n            <span>DHL</span>\n            <span>UPS</span>\n            <span>GLS</span>\n            <span>FedEx</span>\n          </div>\n        </article>\n\n      </div>\n\n      <p class=\"mshome-note\">\n        La compatibilité dépend du fichier et du format\n        proposés par la plateforme ou le transporteur.\n        Pour l'utilisation 4×6, sélectionnez le format\n        100 × 150 mm lorsqu'il est disponible.\n      </p>\n\n    </div>\n  </section>\n\n\n  <!-- =====================================================\n       4 STEPS\n       ===================================================== -->\n\n  <section class=\"mshome-section mshome-soft\">\n\n    <div class=\"mshome-wrap\">\n\n      <div class=\"mshome-heading\">\n        <span>SIMPLE AU QUOTIDIEN</span>\n        <h2>Quatre étapes. Rien de plus.</h2>\n      </div>\n\n      <div class=\"mshome-four\">\n\n        <article>\n          <span>01</span>\n          <h3>Téléchargez</h3>\n          <p>\n            Récupérez le bordereau\n            de votre commande.\n          </p>\n        </article>\n\n        <article>\n          <span>02</span>\n          <h3>Connectez</h3>\n          <p>\n            Bluetooth ou USB\n            selon votre appareil.\n          </p>\n        </article>\n\n        <article>\n          <span>03</span>\n          <h3>Imprimez</h3>\n          <p>\n            Utilisez le format adapté\n            à votre étiquette.\n          </p>\n        </article>\n\n        <article>\n          <span>04</span>\n          <h3>Collez</h3>\n          <p>\n            Appliquez directement\n            l'étiquette sur le colis.\n          </p>\n        </article>\n\n      </div>\n\n    </div>\n  </section>\n\n\n  <!-- =====================================================\n       COMPARATIF\n       ===================================================== -->\n\n  <section class=\"mshome-section\">\n\n    <div class=\"mshome-wrap mshome-comparison-layout\">\n\n      <div>\n\n        <div class=\"mshome-kicker\">\n          THERMIQUE VS A4\n        </div>\n\n        <h2>\n          Une imprimante dédiée à vos colis\n        </h2>\n\n        <p class=\"mshome-copy\">\n          Une imprimante A4 reste adaptée aux documents.\n          Pour des expéditions régulières, le thermique\n          permet un workflow spécialisé autour de\n          l'étiquette adhésive.\n        </p>\n\n      </div>\n\n\n      <div class=\"mshome-table\">\n\n        <div class=\"mshome-table-head\">\n          <span>Critère</span>\n          <strong>X4</strong>\n          <span>A4</span>\n        </div>\n\n        <div>\n          <span>Cartouche / toner</span>\n          <strong>Non</strong>\n          <span>Selon modèle</span>\n        </div>\n\n        <div>\n          <span>Étiquette adhésive</span>\n          <strong>Oui</strong>\n          <span>Support adapté</span>\n        </div>\n\n        <div>\n          <span>Découpage 4×6</span>\n          <strong>Non</strong>\n          <span>Souvent</span>\n        </div>\n\n        <div>\n          <span>Format colis</span>\n          <strong>100 × 150</strong>\n          <span>Selon réglage</span>\n        </div>\n\n        <div>\n          <span>Usage principal</span>\n          <strong>Expédition</strong>\n          <span>Généraliste</span>\n        </div>\n\n      </div>\n\n    </div>\n  </section>\n\n\n  <!-- =====================================================\n       AVIS\n       ===================================================== -->\n\n  <section class=\"mshome-reviews\">\n\n    <div class=\"mshome-wrap\">\n\n      <div class=\"mshome-heading\">\n\n        <span>AVIS CLIENTS METASHOPPER</span>\n\n        <div class=\"mshome-review-score\">\n          ★★★★★ <strong>4,9/5</strong>\n        </div>\n\n        <h2>\n          Des vendeurs partagent leur expérience\n        </h2>\n\n        <p>\n          Installation, impression, livraison,\n          Bluetooth et préparation des commandes.\n        </p>\n\n      </div>\n\n\n      <div class=\"mshome-review-track\">\n\n\n        <article>\n          <di